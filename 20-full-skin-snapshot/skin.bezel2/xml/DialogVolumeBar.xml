<?xml version="1.0" encoding="utf-8"?>
<!-- BEZEL 4.0.0 item 15: volume as a dark pill at the top right (mockups/dialogs/volumebar.png) -->
<window>
	<zorder>4</zorder>
	<controls>
		<control type="group">
			<visible>!Window.IsActive(startup) + !Window.IsActive(GameVolume)</visible>
			<left>1600</left><top>110</top><width>236</width><height>66</height>
			<animation effect="fade" start="100" end="0" time="200" delay="1000" condition="Player.Muted">Conditional</animation>
			<animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
			<control type="image"><left>0</left><top>0</top><width>236</width><height>66</height><texture border="30" colordiffuse="F00E0F12">bezel/pill_fill.png</texture></control>
			<control type="image"><left>22</left><top>17</top><width>32</width><height>32</height><texture colordiffuse="FFFFFFFF">$VAR[VolumeIconVar]</texture></control>
			<control type="progress" id="29999">
				<left>66</left><top>30</top><width>110</width><height>6</height><info>Player.Volume</info>
				<texturebg colordiffuse="40FFFFFF">bezel/white.png</texturebg><lefttexture /><midtexture colordiffuse="FFFF7A26">bezel/white.png</midtexture><righttexture />
			</control>
			<control type="label"><left>176</left><top>0</top><width>44</width><height>66</height><align>right</align><aligny>center</aligny><font>bz_mm20b</font><textcolor>FFFFFFFF</textcolor><label>$INFO[Control.GetLabel(29999)]</label><visible>!Player.Muted</visible></control>
			<control type="label"><left>150</left><top>0</top><width>70</width><height>66</height><align>right</align><aligny>center</aligny><font>bz_mm18b</font><textcolor>FFFF7A26</textcolor><label>MUTE</label><visible>Player.Muted</visible></control>
		</control>
	</controls>
</window>
