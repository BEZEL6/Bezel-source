<?xml version="1.0" encoding="UTF-8"?>
<window>
	<zorder>3</zorder>
	<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
	<controls>
		<!-- v0.1.17: library scan / background progress moved into the black top strip above the bezel (y 6-54, right side, left of the busy spinner corner), one compact line, so it never overlaps the nav, rows or side menu -->
		<control type="group">
			<depth>DepthBars</depth>
			<left>820</left><top>6</top><width>1000</width><height>48</height>
			<animation effect="slide" end="0,-80" time="150" condition="Window.IsVisible(FullscreenVideo) | Window.IsVisible(FullscreenGame)">conditional</animation>
			<control type="grouplist">
				<left>0</left><top>0</top><width>944</width><height>48</height>
				<align>right</align><itemgap>14</itemgap>
				<orientation>horizontal</orientation>
				<control type="label" id="31">
					<description>Title label</description>
					<width min="0" max="380">auto</width><height>48</height>
					<font>bz_small</font><textcolor>80FFFFFF</textcolor><aligny>center</aligny>
				</control>
				<control type="label" id="30">
					<width min="0" max="440">auto</width><height>48</height>
					<font>bz_small</font><textcolor>DDFFFFFF</textcolor><aligny>center</aligny>
				</control>
				<control type="label">
					<width min="0" max="90">auto</width><height>48</height>
					<font>bz_small</font><textcolor>bz_accent</textcolor><aligny>center</aligny>
					<label>$INFO[Control.GetLabel(32),,%]</label>
				</control>
			</control>
			<control type="group">
				<left>956</left><top>4</top>
				<control type="image"><width>40</width><height>40</height><texture>dialogs/extendedprogress/loading-back.png</texture></control>
				<control type="image"><width>40</width><height>40</height><texture>$INFO[Control.GetLabel(32),dialogs/volume/progress/p,.png]</texture>
					<animation effect="fade" end="50" time="0" condition="true">Conditional</animation></control>
				<control type="image"><width>40</width><height>40</height><texture>dialogs/extendedprogress/loading.png</texture>
					<animation effect="rotate" center="auto" start="360" end="0" time="1500" loop="true" condition="true">Conditional</animation></control>
			</control>
			<control type="progress" id="32"><left>3000</left><height>15</height></control>
		</control>
	</controls>
</window>
