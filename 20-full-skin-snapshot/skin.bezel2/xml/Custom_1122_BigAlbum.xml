<?xml version="1.0" encoding="utf-8"?>
<!-- 5.33.309 P1: the big album. One always-open dialog, so the sway never remounts when you change section.
     It opens by itself (it has a visible tag), like Dust 1114. Kodi opens it modeless: it never takes keys, so NOTHING focusable lives here.
     Touch / mouse still reach it (tap 6180 on the album opens Play Next 1120 in Music).
     Where it shows: $EXP[bz_railvis] (Music lists, MM over other sections while music plays, Kodi FS, Play Next 1120, Music fan art 1121).
     Where it sits: home (x 1140) or centre (x 660, $EXP[bz_railc]). bz_rail on Home: centre / home / hide. Sections only set that property.
     Two real copies with a real left (as 5.33.307) so each copy's sway camera is right at rest. 5.33.310: both copies are ALWAYS visible (never Visible=false,
     so the inner art / NP Visible fades never restart). They slide together with Conditional slides at FS Slide speed (bz_at_fsslide); the copy that is
     leaving its resting spot goes alpha 0 only when the slide ends (fade time 0, delay = slide time). Reversing restores its alpha at once. No fade, no gap. -->
<window type="dialog" id="1122">
	<zorder>0</zorder>
	<!-- 5.33.412 ARTUNDERSPLASH (Rob t2926): no splash_done gate; opens under the splash so art loads behind it. Group 6400 holds alpha 0 while bz_warm_gate, then fades in 3000 ms with the splash fade. 5.33.417: hold anim is 100->0 (time 0) so it releases to 100 when the gate clears. -->
	<visible>!Window.IsActive(fullscreenvideo) + !Window.IsActive(slideshow) + !Window.IsActive(screensaver) + !Window.IsActive(1113)</visible>
	<animation effect="fade" start="0" end="100" time="600" tween="sine" easing="inout">WindowOpen</animation><animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
	<controls>
		<!-- 5.33.472 FANPRELOAD (Rob: "the new 1121 will always have its fanart stage ready"): the playing artist's fanart is kept decoded here (same path, size and aspect as the NP stage image, 1 % alpha, off-screen-safe) so 1121 opens from any section with the stage art already in the texture cache -->
		<control type="image"><left>bz_stage_x</left><top>120</top><width>bz_stage_w</width><height>900</height><aspectratio>scale</aspectratio><texture background="true" colordiffuse="03FFFFFF">$INFO[Player.Art(artist.fanart)]</texture><visible>Player.HasAudio + !Player.HasVideo + !Window.IsVisible(1121) + !Window.IsActive(visualisation)</visible></control>

		<!-- 5.33.366 Rob t2616 GLOBAL ARTWORK GROUP 6400: album layer (cover + leaf-flip/sway + cast) + Compact NP (rides 6397/FS rails) + poster layer, one shared frame.
		     Both layers are ALWAYS drawn (never Visible=false) so textures stay warm and the sway clocks never restart; Music<->Movies/TV is an opacity crossfade only.
		     Colour strip and MM Warm underlay are NOT in this group. bz_rail=hide is the only hard hide. -->
		<control type="group" id="6400"><visible>!String.IsEqual(Window(Home).Property(bz_rail),hide)</visible><!-- 5.33.417 ARTGATEFIX: hold is start=100 end=0 so its reversed rest state is 100 (start=0 rested at alpha 0 forever = art never shown) --><animation effect="fade" start="100" end="0" time="0" condition="!String.IsEmpty(Window(Home).Property(bz_warm_gate))">Conditional</animation><animation effect="fade" start="0" end="100" time="3000" tween="sine" easing="inout" condition="String.IsEmpty(Window(Home).Property(bz_warm_gate))">Conditional</animation>
		<!-- 5.33.444 RAILXFADE (Rob: "BIG ALBUM STRETCHES" on the slide to centre / back home): Kodi keeps each copy's sway camera at its resting spot, so a copy sliding away from it is seen off-axis (stretched). Both copies were full opacity for the whole slide; now the leaving copy fades out and the arriving copy fades in over the slide. -->
		<!-- POSTER LAYER 6401 (under the album), 5.33.367 Rob t2622: the ONE Movies/TV poster. Full BezelVPLPoster (sway, cast, glares, LOOK, badges, frame) lives here;
		     the per-screen mounts are gone (only BezelVPLPosterTap stays on the screens). All list-60 data comes from the bz_flip Home mirror (bz_v60_*), since 1122 can't see list 60.
		     Opacity: 100 while the poster screen is up (bz_vpl_on = old mount gates) or a Music<->Videos handoff runs; 0 otherwise. Always drawn, never Visible=false, so texture + sway stay warm.
		     BezelSecDim inside (the old mounts sat in the section parent group's SecDim). -->
		<control type="group" id="6401"><!-- one inverse fade (Kodi multiplies fade anims) -->
			<animation effect="fade" start="100" end="0" time="200" tween="sine" easing="inout" condition="[!$EXP[bz_artposter]] + String.IsEqual(Skin.String(bz_at_a2pfade),1)">Conditional</animation><animation effect="fade" start="100" end="0" time="250" tween="sine" easing="inout" condition="[!$EXP[bz_artposter]] + String.IsEqual(Skin.String(bz_at_a2pfade),2)">Conditional</animation><animation effect="fade" start="100" end="0" time="300" tween="sine" easing="inout" condition="[!$EXP[bz_artposter]] + String.IsEqual(Skin.String(bz_at_a2pfade),3)">Conditional</animation><animation effect="fade" start="100" end="0" time="400" tween="sine" easing="inout" condition="[!$EXP[bz_artposter]] + String.IsEqual(Skin.String(bz_at_a2pfade),4)">Conditional</animation><animation effect="fade" start="100" end="0" time="500" tween="sine" easing="inout" condition="[!$EXP[bz_artposter]] + String.IsEqual(Skin.String(bz_at_a2pfade),5)">Conditional</animation><animation effect="fade" start="100" end="0" time="600" tween="sine" easing="inout" condition="[!$EXP[bz_artposter]] + String.IsEqual(Skin.String(bz_at_a2pfade),6)">Conditional</animation><animation effect="fade" start="100" end="0" time="800" tween="sine" easing="inout" condition="[!$EXP[bz_artposter]] + [String.IsEmpty(Skin.String(bz_at_a2pfade)) | String.IsEqual(Skin.String(bz_at_a2pfade),7)]">Conditional</animation><!-- 5.33.394 A2PFADE: 7 mutually exclusive steps (bz_at_a2pfade) = still ONE active fade --><!-- 5.33.392 A2P: shared gate with 6402 -->
			<control type="image"><!-- 5.33.372 POSTERHOLD preload slot: bz_flip stages new poster art here (near-invisible) for 0.6 s so the texture is decoded before it becomes bz_v60_art -->
				<left>bz_art_x</left><top>120</top><width>600</width><height>900</height><aspectratio>scale</aspectratio><colordiffuse>01FFFFFF</colordiffuse>
				<texture background="true">$INFO[Window(Home).Property(bz_v60_next)]</texture></control>
			<!-- 5.33.419 HOLDWARM Rob pt2939u: keep both DUALHOLD poster holds decoded (near-invisible). On an MM-open Movies<->TV row change
			     bz_flip swaps bz_v60_art straight to bz_v60_mov / bz_v60_tv; if that texture had been evicted, Kodi's 1000 ms fadetime faded the old
			     poster out while the hold was still loading in the background = brief dip to black. Warm holds = instant swap, true crossfade. -->
			<control type="image"><left>bz_art_x</left><top>120</top><width>600</width><height>900</height><aspectratio>scale</aspectratio><colordiffuse>01FFFFFF</colordiffuse>
				<texture background="true">$INFO[Window(Home).Property(bz_v60_mov)]</texture></control>
			<control type="image"><left>bz_art_x</left><top>120</top><width>600</width><height>900</height><aspectratio>scale</aspectratio><colordiffuse>01FFFFFF</colordiffuse>
				<texture background="true">$INFO[Window(Home).Property(bz_v60_tv)]</texture></control>
			<control type="group"><!-- handoff pre-warm (same mirrored texture): only during the Music<->Videos crossfade, before bz_pready arms the swaying stack -->
				<animation effect="fade" start="100" end="0" time="200" tween="sine" easing="inout" condition="[![[Window.IsActive(videos) + [String.IsEqual(Window(Home).Property(bz_tovideo),fade) | String.IsEqual(Window(Home).Property(bz_m2v_flat),true)]] | String.IsEqual(Window(Home).Property(bz_tomusic),true)]] + String.IsEqual(Skin.String(bz_at_a2pfade),1)">Conditional</animation><animation effect="fade" start="100" end="0" time="250" tween="sine" easing="inout" condition="[![[Window.IsActive(videos) + [String.IsEqual(Window(Home).Property(bz_tovideo),fade) | String.IsEqual(Window(Home).Property(bz_m2v_flat),true)]] | String.IsEqual(Window(Home).Property(bz_tomusic),true)]] + String.IsEqual(Skin.String(bz_at_a2pfade),2)">Conditional</animation><animation effect="fade" start="100" end="0" time="300" tween="sine" easing="inout" condition="[![[Window.IsActive(videos) + [String.IsEqual(Window(Home).Property(bz_tovideo),fade) | String.IsEqual(Window(Home).Property(bz_m2v_flat),true)]] | String.IsEqual(Window(Home).Property(bz_tomusic),true)]] + String.IsEqual(Skin.String(bz_at_a2pfade),3)">Conditional</animation><animation effect="fade" start="100" end="0" time="400" tween="sine" easing="inout" condition="[![[Window.IsActive(videos) + [String.IsEqual(Window(Home).Property(bz_tovideo),fade) | String.IsEqual(Window(Home).Property(bz_m2v_flat),true)]] | String.IsEqual(Window(Home).Property(bz_tomusic),true)]] + String.IsEqual(Skin.String(bz_at_a2pfade),4)">Conditional</animation><animation effect="fade" start="100" end="0" time="500" tween="sine" easing="inout" condition="[![[Window.IsActive(videos) + [String.IsEqual(Window(Home).Property(bz_tovideo),fade) | String.IsEqual(Window(Home).Property(bz_m2v_flat),true)]] | String.IsEqual(Window(Home).Property(bz_tomusic),true)]] + String.IsEqual(Skin.String(bz_at_a2pfade),5)">Conditional</animation><animation effect="fade" start="100" end="0" time="600" tween="sine" easing="inout" condition="[![[Window.IsActive(videos) + [String.IsEqual(Window(Home).Property(bz_tovideo),fade) | String.IsEqual(Window(Home).Property(bz_m2v_flat),true)]] | String.IsEqual(Window(Home).Property(bz_tomusic),true)]] + String.IsEqual(Skin.String(bz_at_a2pfade),6)">Conditional</animation><animation effect="fade" start="100" end="0" time="800" tween="sine" easing="inout" condition="[![[Window.IsActive(videos) + [String.IsEqual(Window(Home).Property(bz_tovideo),fade) | String.IsEqual(Window(Home).Property(bz_m2v_flat),true)]] | String.IsEqual(Window(Home).Property(bz_tomusic),true)]] + [String.IsEmpty(Skin.String(bz_at_a2pfade)) | String.IsEqual(Skin.String(bz_at_a2pfade),7)]">Conditional</animation><!-- 5.33.394 A2PFADE: 7 mutually exclusive steps (bz_at_a2pfade) = still ONE active fade -->
				<control type="image"><left>bz_art_x</left><top>120</top><width>600</width><height>900</height><aspectratio>scale</aspectratio><diffuse>bezel/art_mask.png</diffuse><fadetime>300</fadetime>
					<texture background="true">$INFO[Window(Home).Property(bz_v60_art)]</texture></control>
			</control>
			<control type="group"><include>BezelSecDimArt</include><include>BezelVPLPoster</include></control><!-- steady swaying poster -->
		</control>
		<!-- ALBUM LAYER: opacity-gated by bz_railvis (was Visible= in .309-.365) — no remount, sway/flip clocks unbroken, cover stays loaded. -->
		<control type="group" id="6402"><include>BezelSecDim</include><!-- 5.33.444: album keeps the MM dim during auto-hide (Rob: "JUST POSTER AND FANART") --><!-- 5.33.314 Rob t2384: MM dim / Global dim wired to big album (cast+art+NP) -->
			<animation effect="fade" start="100" end="0" time="200" tween="sine" easing="inout" condition="[[$EXP[bz_artposter] + !String.IsEqual(Window(Home).Property(bz_tomusic),true)] | [!$EXP[bz_railvis] + String.IsEmpty(Window(Home).Property(bz_a2p_hold))]] + String.IsEqual(Skin.String(bz_at_a2pfade),1)">Conditional</animation><animation effect="fade" start="100" end="0" time="250" tween="sine" easing="inout" condition="[[$EXP[bz_artposter] + !String.IsEqual(Window(Home).Property(bz_tomusic),true)] | [!$EXP[bz_railvis] + String.IsEmpty(Window(Home).Property(bz_a2p_hold))]] + String.IsEqual(Skin.String(bz_at_a2pfade),2)">Conditional</animation><animation effect="fade" start="100" end="0" time="300" tween="sine" easing="inout" condition="[[$EXP[bz_artposter] + !String.IsEqual(Window(Home).Property(bz_tomusic),true)] | [!$EXP[bz_railvis] + String.IsEmpty(Window(Home).Property(bz_a2p_hold))]] + String.IsEqual(Skin.String(bz_at_a2pfade),3)">Conditional</animation><animation effect="fade" start="100" end="0" time="400" tween="sine" easing="inout" condition="[[$EXP[bz_artposter] + !String.IsEqual(Window(Home).Property(bz_tomusic),true)] | [!$EXP[bz_railvis] + String.IsEmpty(Window(Home).Property(bz_a2p_hold))]] + String.IsEqual(Skin.String(bz_at_a2pfade),4)">Conditional</animation><animation effect="fade" start="100" end="0" time="500" tween="sine" easing="inout" condition="[[$EXP[bz_artposter] + !String.IsEqual(Window(Home).Property(bz_tomusic),true)] | [!$EXP[bz_railvis] + String.IsEmpty(Window(Home).Property(bz_a2p_hold))]] + String.IsEqual(Skin.String(bz_at_a2pfade),5)">Conditional</animation><animation effect="fade" start="100" end="0" time="600" tween="sine" easing="inout" condition="[[$EXP[bz_artposter] + !String.IsEqual(Window(Home).Property(bz_tomusic),true)] | [!$EXP[bz_railvis] + String.IsEmpty(Window(Home).Property(bz_a2p_hold))]] + String.IsEqual(Skin.String(bz_at_a2pfade),6)">Conditional</animation><animation effect="fade" start="100" end="0" time="800" tween="sine" easing="inout" condition="[[$EXP[bz_artposter] + !String.IsEqual(Window(Home).Property(bz_tomusic),true)] | [!$EXP[bz_railvis] + String.IsEmpty(Window(Home).Property(bz_a2p_hold))]] + [String.IsEmpty(Skin.String(bz_at_a2pfade)) | String.IsEqual(Skin.String(bz_at_a2pfade),7)]">Conditional</animation><!-- 5.33.394 A2PFADE: 7 mutually exclusive steps (bz_at_a2pfade) = still ONE active fade --><!-- 5.33.392 A2P Rob t2746: album down on the SAME gate/frame/duration as 6401 up; bz_a2p_hold bridges the Music-leave gap -->
			<control type="group"><visible>!$EXP[bz_gridm] | $EXP[bz_np]</visible><!-- 5.33.392 A2P: old non-reversible tovideo 600 / m2v_flat 500 fades removed (outer shared gate covers them; no album jump-back) -->
				<include>BezelAlbumCast</include>
				<control type="group"><animation type="Conditional" condition="$EXP[bz_railc] + String.IsEqual(Skin.String(bz_at_fsslide),1)"><effect type="slide" start="0,0" end="-480,0" time="480" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="480" tween="sine" easing="inout"/></animation><animation type="Conditional" condition="$EXP[bz_railc] + String.IsEqual(Skin.String(bz_at_fsslide),2)"><effect type="slide" start="0,0" end="-480,0" time="380" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="380" tween="sine" easing="inout"/></animation><animation type="Conditional" condition="$EXP[bz_railc] + [String.IsEmpty(Skin.String(bz_at_fsslide)) | String.IsEqual(Skin.String(bz_at_fsslide),3)]"><effect type="slide" start="0,0" end="-480,0" time="280" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="280" tween="sine" easing="inout"/></animation><animation type="Conditional" condition="$EXP[bz_railc] + String.IsEqual(Skin.String(bz_at_fsslide),4)"><effect type="slide" start="0,0" end="-480,0" time="180" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="180" tween="sine" easing="inout"/></animation><include>BezelMusicPlayingArt</include></control><!-- home copy (camera 1440): slides to centre, stays drawn until the slide ends, then alpha 0 (no remount) -->
				<control type="group"><left>-480</left><animation effect="fade" start="0" end="100" time="0" delay="600" condition="!$EXP[bz_railc]">WindowOpen</animation><animation type="Conditional" condition="!$EXP[bz_railc] + String.IsEqual(Skin.String(bz_at_fsslide),1)"><effect type="slide" start="0,0" end="480,0" time="480" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="480" tween="sine" easing="inout"/></animation><animation type="Conditional" condition="!$EXP[bz_railc] + String.IsEqual(Skin.String(bz_at_fsslide),2)"><effect type="slide" start="0,0" end="480,0" time="380" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="380" tween="sine" easing="inout"/></animation><animation type="Conditional" condition="!$EXP[bz_railc] + [String.IsEmpty(Skin.String(bz_at_fsslide)) | String.IsEqual(Skin.String(bz_at_fsslide),3)]"><effect type="slide" start="0,0" end="480,0" time="280" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="280" tween="sine" easing="inout"/></animation><animation type="Conditional" condition="!$EXP[bz_railc] + String.IsEqual(Skin.String(bz_at_fsslide),4)"><effect type="slide" start="0,0" end="480,0" time="180" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="180" tween="sine" easing="inout"/></animation><include>BezelMusicPlayingArt</include></control><!-- centre copy (camera 960): parked at home under alpha 0; reverse = shows at once and slides with the home copy -->
			</control>
		</control>
			<!-- 5.33.450 VIZNPBAR (Rob: "ADD NP BAR TO KODI FULLSCREEN VIZ WHEN BIG ALBUM IS CENTER"; it showed on the FS fanart dialog only): the compact NP bar
			     (artist / title / progress / time, same include as Play Next + Fanart FS 1121) under the centred big album in Kodi FS viz. Drawn here, in 1122, because 1122
			     renders above the viz window and covered the viz window's own copy (now hidden in viz). Gate = viz chrome shown (bz_fsnp) + album at centre. -->
			<control type="group"><left>-480</left><visible>[Window.IsActive(visualisation) | Window.IsVisible(1121)] + String.IsEqual(Window(Home).Property(bz_fsnp),true) + $EXP[bz_railc] + Player.HasAudio</visible><!-- 5.33.470 CENTREBAR (Rob: "np bar shown when big album is center in both fullscreen, hide when switch back to fanart stage"): 450 VIZNPBAR now also under the centred album in the fanart FS (1121); bz_railc drops on the switch back -> 300 ms fade out -->
				<animation effect="fade" start="0" end="100" time="600" delay="480" tween="sine" easing="inout">Visible</animation><animation effect="fade" start="100" end="0" time="300" tween="sine" easing="inout">Hidden</animation>
				<include>BezelNPCompactBar</include>
			</control>
		</control><!-- /6400 -->
	</controls>
</window>
