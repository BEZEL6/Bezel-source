<?xml version="1.0" encoding="utf-8"?>
<!-- 5.33.309 P1: the big album. One always-open dialog, so the sway never remounts when you change section.
     It opens by itself (it has a visible tag), like Dust 1114. Kodi opens it modeless: it never takes keys, so NOTHING focusable lives here.
     Touch / mouse still reach it (tap 6180 on the album opens Play Next 1120 in Music).
     Where it shows: $EXP[bz_railvis] (Music lists, MM over other sections while music plays, Kodi FS, Play Next 1120, Music fan art 1121).
     Where it sits: home (x 1140) or centre (x 660, $EXP[bz_railc]). bz_rail on Home: centre / home / hide. Sections only set that property.
     Two real copies with a real left (as 5.33.307) so each copy's sway camera is right at rest. 5.33.310: both copies are ALWAYS visible (never Visible=false,
     so the inner art / NP Visible fades never restart). They slide together with Conditional slides at FS Slide speed (bz_at_fsslide); the copy that is
     leaving its resting spot goes alpha 0 only when the slide ends (fade time 0, delay = slide time). Reversing restores its alpha at once. No fade, no gap. -->
<window type="dialog" id="1122">
	<zorder>0</zorder>
	<visible>String.IsEqual(Window(Home).Property(bz_splash_done),1) + !Window.IsActive(fullscreenvideo) + !Window.IsActive(slideshow) + !Window.IsActive(screensaver) + !Window.IsActive(1113)</visible>
	<animation effect="fade" start="0" end="100" time="600" tween="sine" easing="inout">WindowOpen</animation><animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
	<controls>
		<control type="group"><visible>$EXP[bz_railvis] + !String.IsEqual(Window(Home).Property(bz_rail),hide)</visible><include>BezelSecDim</include><!-- 5.33.314 Rob t2384: MM dim / Global dim wired to big album (cast+art+NP) -->
			<animation effect="fade" start="0" end="100" time="400" tween="sine" easing="inout">Visible</animation><animation effect="fade" start="100" end="0" time="300" tween="sine" easing="inout">Hidden</animation>
			<control type="group"><visible>!$EXP[bz_gridm] | $EXP[bz_np]</visible>
				<animation effect="fade" start="100" end="0" time="600" tween="sine" easing="inout" reversible="false" condition="String.IsEqual(Window(Home).Property(bz_tovideo),fade)">Conditional</animation>
				<animation effect="fade" start="100" end="0" time="500" tween="sine" easing="inout" reversible="false" condition="String.IsEqual(Window(Home).Property(bz_m2v_flat),true)">Conditional</animation>
				<include>BezelAlbumCast</include>
				<control type="group"><animation type="Conditional" condition="$EXP[bz_railc] + String.IsEqual(Skin.String(bz_at_fsslide),1)"><effect type="slide" start="0,0" end="-480,0" time="480" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="0" delay="480"/></animation><animation type="Conditional" condition="$EXP[bz_railc] + String.IsEqual(Skin.String(bz_at_fsslide),2)"><effect type="slide" start="0,0" end="-480,0" time="380" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="0" delay="380"/></animation><animation type="Conditional" condition="$EXP[bz_railc] + [String.IsEmpty(Skin.String(bz_at_fsslide)) | String.IsEqual(Skin.String(bz_at_fsslide),3)]"><effect type="slide" start="0,0" end="-480,0" time="280" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="0" delay="280"/></animation><animation type="Conditional" condition="$EXP[bz_railc] + String.IsEqual(Skin.String(bz_at_fsslide),4)"><effect type="slide" start="0,0" end="-480,0" time="180" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="0" delay="180"/></animation><include>BezelMusicPlayingArt</include></control><!-- home copy (camera 1440): slides to centre, stays drawn until the slide ends, then alpha 0 (no remount) -->
				<control type="group"><left>-480</left><animation effect="fade" start="0" end="100" time="0" delay="600" condition="!$EXP[bz_railc]">WindowOpen</animation><animation type="Conditional" condition="!$EXP[bz_railc] + String.IsEqual(Skin.String(bz_at_fsslide),1)"><effect type="slide" start="0,0" end="480,0" time="480" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="0" delay="480"/></animation><animation type="Conditional" condition="!$EXP[bz_railc] + String.IsEqual(Skin.String(bz_at_fsslide),2)"><effect type="slide" start="0,0" end="480,0" time="380" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="0" delay="380"/></animation><animation type="Conditional" condition="!$EXP[bz_railc] + [String.IsEmpty(Skin.String(bz_at_fsslide)) | String.IsEqual(Skin.String(bz_at_fsslide),3)]"><effect type="slide" start="0,0" end="480,0" time="280" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="0" delay="280"/></animation><animation type="Conditional" condition="!$EXP[bz_railc] + String.IsEqual(Skin.String(bz_at_fsslide),4)"><effect type="slide" start="0,0" end="480,0" time="180" tween="sine" easing="inout"/><effect type="fade" start="100" end="0" time="0" delay="180"/></animation><include>BezelMusicPlayingArt</include></control><!-- centre copy (camera 960): parked at home under alpha 0; reverse = shows at once and slides with the home copy -->
			</control>
		</control>
	</controls>
</window>
