<?xml version="1.0" encoding="UTF-8"?>
<!-- 2.0.0-beta1.np1 (TEST): Now Playing as a (modal) dialog over BEZEL MUSIC LIST. Used ONLY when music plays and the music window is already up in the
     list view (view 60, not the grid): bz_cmd.py np (logo menu entry, 60 s idle open) sets bz_npdlg + bz_np and opens it. Every other route keeps the in-place panel.
     Back / Left / the logo close it; bz_flip.py closes it if bz_np is cleared elsewhere.
     The music window is never reloaded or refocused: the album, its sway, glares and sway shadow keep running underneath and the list keeps its item.
     Same panel (BezelNPInPlace: x 120-960, fanart, song info, progress, cycle button with Up Next) and the same player controls (BezelNPControls). -->
<window type="dialog" id="1112">
	<zorder>1</zorder><!-- BEZEL 3.0: above the persistent dust dialog (1114, zorder 0) -->
	<defaultcontrol always="true">6390</defaultcontrol>
	<menucontrol>6385</menucontrol>
	<!-- Back from any control (or Kodi closing the dialog) ends Now Playing; kept while Kodi's fullscreen window bounces back (Tab), like the music window's onunload -->
	<!-- BETA 1.1: opened straight from the Tab / Display keymap (no script): music playing in the music list view -> Now Playing; anything else -> close at once
	     and run Kodi's fullscreen music window (the old route). Opened by bz_cmd.py (menu card, idle) bz_np is already set. -->
	<!-- BETA 1.1b: the gate below uses Player.HasAudio directly (the debounced bz_audio_latch from bz_flip.py may not be set yet on the first Tab after Kodi start; setting it here would skip the sway start in bz_flip.py) -->
	<onload condition="![String.IsEqual(Window(Home).Property(bz_np),true) | [Window.IsActive(music) + Player.HasAudio + !Player.HasVideo + !Window.IsActive(visualisation) + String.IsEmpty(Window(Home).Property(bz_nav)) + ![Skin.HasSetting(bz_grid_music) + [Container.Content(albums) | Container.Content(artists)]]]]">Dialog.Close(1112,true)</onload>
	<onload condition="![String.IsEqual(Window(Home).Property(bz_np),true) | [Window.IsActive(music) + Player.HasAudio + !Player.HasVideo + !Window.IsActive(visualisation) + String.IsEmpty(Window(Home).Property(bz_nav)) + ![Skin.HasSetting(bz_grid_music) + [Container.Content(albums) | Container.Content(artists)]]]]">ActivateWindow(visualisation)</onload>
	<onload condition="[String.IsEqual(Window(Home).Property(bz_np),true) | [Window.IsActive(music) + Player.HasAudio + !Player.HasVideo + !Window.IsActive(visualisation) + String.IsEmpty(Window(Home).Property(bz_nav)) + ![Skin.HasSetting(bz_grid_music) + [Container.Content(albums) | Container.Content(artists)]]]]">SetProperty(bz_npdlg,true,home)</onload>
	<onload condition="[String.IsEqual(Window(Home).Property(bz_np),true) | [Window.IsActive(music) + Player.HasAudio + !Player.HasVideo + !Window.IsActive(visualisation) + String.IsEmpty(Window(Home).Property(bz_nav)) + ![Skin.HasSetting(bz_grid_music) + [Container.Content(albums) | Container.Content(artists)]]]]">SetProperty(bz_np,true,home)</onload>
	<onunload condition="!Window.IsActive(visualisation)">ClearProperty(bz_np,home)</onunload>
	<onunload>ClearProperty(bz_npdlg,home)</onunload>
	<controls>
		<control type="group"><!-- 4.7.4: SECTION PARENT GROUP — Global Dim fade under MM --><include>BezelSecDim</include>
		<control type="group">
			<!-- np2: Rob: exactly 1000 ms fade in and out, sine in-out. The fade itself is the panel's own Visible / Hidden fade (1000 ms via the include param);
			     closing clears bz_np first, so the panel fades out while the list fades back in underneath (crossfade, as before). This no-op close
			     animation only keeps the dialog drawn for those 1000 ms. -->
			<animation effect="fade" start="100" end="100" time="1000" condition="!String.IsEqual(Window(Home).Property(bz_np),true)">WindowClose</animation>
			<!-- BETA 1.1: Tab / Display close the dialog directly (bz_np still set): then the whole dialog does the 1000 ms sine fade itself -->
			<animation effect="fade" start="100" end="0" time="1000" tween="sine" easing="inout" condition="String.IsEqual(Window(Home).Property(bz_np),true)">WindowClose</animation>
			<control type="group"><animation effect="fade" start="100" end="0" time="480" tween="sine" easing="inout" condition="[Window.IsActive(1120) | [Window.IsActive(1121) + !String.IsEqual(Window(Home).Property(bz_pnoff),1)] | String.IsEqual(Window(Home).Property(bz_fsret),true)] + String.IsEqual(Skin.String(bz_at_fsslide),1)">Conditional</animation><animation effect="fade" start="100" end="0" time="380" tween="sine" easing="inout" condition="[Window.IsActive(1120) | [Window.IsActive(1121) + !String.IsEqual(Window(Home).Property(bz_pnoff),1)] | String.IsEqual(Window(Home).Property(bz_fsret),true)] + String.IsEqual(Skin.String(bz_at_fsslide),2)">Conditional</animation><animation effect="fade" start="100" end="0" time="280" tween="sine" easing="inout" condition="[Window.IsActive(1120) | [Window.IsActive(1121) + !String.IsEqual(Window(Home).Property(bz_pnoff),1)] | String.IsEqual(Window(Home).Property(bz_fsret),true)] + [String.IsEmpty(Skin.String(bz_at_fsslide)) | String.IsEqual(Skin.String(bz_at_fsslide),3)]">Conditional</animation><animation effect="fade" start="100" end="0" time="180" tween="sine" easing="inout" condition="[Window.IsActive(1120) | [Window.IsActive(1121) + !String.IsEqual(Window(Home).Property(bz_pnoff),1)] | String.IsEqual(Window(Home).Property(bz_fsret),true)] + String.IsEqual(Skin.String(bz_at_fsslide),4)">Conditional</animation><!-- 5.33.163 FS slide speed (bz_at_fsslide): Slow 480 legacy / Mid-low 380 / Mid-high 280 default / Fast 180 --><!-- 5.33.85 t560: Dialogue FS over this dialog: NP/fanart stage slides fully off-frame (same 5 s sine as the Music window stage) --><include content="BezelNPInPlace"><param name="npfade" value="1000"/><param name="bg" value="true"/><!-- t4224 Fullscreen Music 2: black+fanart block covers list/small album/strip --><param name="dlg" value="true"/><param name="upc1" value="4DFFFFFF"/><param name="upc2" value="4DFFFFFF"/><param name="upc3" value="4DFFFFFF"/></include><!-- BETA 2 item 4 (17:33): Up Next text white 30%, same as fullscreen 12006 --><!-- BETA 1.3: no background (Rob t1244u): text + low-opacity visualiser in the box; the music window fades its rows / album / info, the real sway shadow shows --></control>
			<include content="BezelNPControls"><param name="vis" value="$EXP[bz_np] + String.IsEqual(Window(Home).Property(bz_npctl),true)"/><param name="dx" value="0"/><param name="box" value="false"/></include>
		</control>
		<!-- the music window's logo (drawn underneath) cannot take taps under a modal dialog: same 120x116 hit area here, a tap ends Now Playing like before -->
		<control type="button" id="6387"><left>0</left><top>0</top><width>120</width><height>116</height><label></label><texturefocus></texturefocus><texturenofocus></texturenofocus>
			<onclick>ClearProperty(bz_np,home)</onclick><onclick>Dialog.Close(1112)</onclick></control>
		<!-- Back trap: the panel's Back / Left name 6299 (the music window's trap); here it closes the dialog -->
		<control type="button" id="6299"><left>-400</left><top>0</top><width>10</width><height>10</height><label></label><texturefocus></texturefocus><texturenofocus></texturenofocus><onfocus>ClearProperty(bz_np,home)</onfocus><onfocus>Dialog.Close(1112)</onfocus></control>
		<control type="button" id="6385"><left>-400</left><top>40</top><width>10</width><height>10</height><label></label><texturefocus></texturefocus><texturenofocus></texturenofocus>
			<onfocus>SetFocus(6390)</onfocus><onfocus>RunScript(special://skin/scripts/bz_cmd.py,npctl,toggle)</onfocus></control>
		<!-- BETA 1.1: Left opens the slide menu ON TOP of Now Playing: the same BezelNavMenu include, drawn last in this dialog (the dialog stays open).
		     The menu's "back to the list" targets (60 / SetFocus(60)) land on this off-screen proxy, which closes the menu and returns focus to Now Playing. -->
		<control type="button" id="60"><left>-400</left><top>80</top><width>10</width><height>10</height><label></label><texturefocus></texturefocus><texturenofocus></texturenofocus>
			<onfocus>ClearProperty(bz_nav,home)</onfocus><onfocus>ClearProperty(bz_navtune,home)</onfocus><onfocus>ClearProperty(bz_navbez,home)</onfocus><onfocus>SetFocus(6390)</onfocus></control>
		</control><!-- 4.7.4 end SECTION PARENT GROUP -->
		<include>BezelNavMenu</include>
		<!-- 4.0.1 O36 (Rob): album tap-to-enlarge/shrink target 6188 removed -->
	</controls>
</window>
