<!-- BETA 2.7 item 1: BEZEL standard view weather (was Estuary). Rows: current, the 7-day forecast, next location, settings. Original in backup_bezel2_beta27_pre. -->
<window>
	<defaultcontrol always="true">300</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<menucontrol>311</menucontrol>
	<controls><control type="group"><!-- 4.7.5: Global Dim wrap --><include>BezelSecDim</include>
		<control type="group">
			<include>BezelWindowFade</include>
			<include content="BezelStdFrame">
				<param name="title" value="$LOCALIZE[8]"/>
				<param name="sub" value="$INFO[Weather.Location]"/>
				<param name="head" value="$VAR[BezelWxHead]"/>
				<param name="body" value="[UPPERCASE]$VAR[BezelWxBody][/UPPERCASE]"/>
				<param name="art" value="$VAR[BezelWxArt]"/><param name="listw" value="0"/><param name="showinfo" value="false"/><!-- 5.33.12: rows in colour strip, current+forecast in fanart block (Rob t149) -->
			</include>
			<control type="grouplist" id="9000">
				<left>bz_strip_x</left><top>120</top><width>bz_strip_w</width><height>900</height><itemgap>0</itemgap><orientation>vertical</orientation>
				<control type="button" id="300"><onback>SetProperty(bz_nav,true,home)</onback><!-- 5.33.179 BUG-024 (BUG-013 pattern): Back opens MM same frame as close, no underlay stop --><width>bz_strip_w</width><height>60</height><font>bz_list_music</font><textoffsetx>23</textoffsetx><aligny>center</aligny><align>left</align><textcolor>FFEBEBEB</textcolor><focusedcolor>FF000000</focusedcolor><label>CURRENT</label><texturefocus>colors/white.png</texturefocus><texturenofocus/></control>
				<control type="button" id="301"><onback>SetProperty(bz_nav,true,home)</onback><!-- 5.33.179 BUG-024 (BUG-013 pattern): Back opens MM same frame as close, no underlay stop --><width>bz_strip_w</width><height>60</height><font>bz_list_music</font><textoffsetx>23</textoffsetx><aligny>center</aligny><textcolor>FFEBEBEB</textcolor><focusedcolor>FF000000</focusedcolor><texturefocus>colors/white.png</texturefocus><texturenofocus/><label>$INFO[Window(weather).Property(Day0.Title)]</label><label2>$INFO[Window(weather).Property(Day0.HighTemp)]$INFO[Window(weather).Property(Day0.LowTemp), / ]</label2><visible>!String.IsEmpty(Window(weather).Property(Day0.Title))</visible></control>
				<control type="button" id="302"><onback>SetProperty(bz_nav,true,home)</onback><!-- 5.33.179 BUG-024 (BUG-013 pattern): Back opens MM same frame as close, no underlay stop --><width>bz_strip_w</width><height>60</height><font>bz_list_music</font><textoffsetx>23</textoffsetx><aligny>center</aligny><textcolor>FFEBEBEB</textcolor><focusedcolor>FF000000</focusedcolor><texturefocus>colors/white.png</texturefocus><texturenofocus/><label>$INFO[Window(weather).Property(Day1.Title)]</label><label2>$INFO[Window(weather).Property(Day1.HighTemp)]$INFO[Window(weather).Property(Day1.LowTemp), / ]</label2><visible>!String.IsEmpty(Window(weather).Property(Day1.Title))</visible></control>
				<control type="button" id="303"><onback>SetProperty(bz_nav,true,home)</onback><!-- 5.33.179 BUG-024 (BUG-013 pattern): Back opens MM same frame as close, no underlay stop --><width>bz_strip_w</width><height>60</height><font>bz_list_music</font><textoffsetx>23</textoffsetx><aligny>center</aligny><textcolor>FFEBEBEB</textcolor><focusedcolor>FF000000</focusedcolor><texturefocus>colors/white.png</texturefocus><texturenofocus/><label>$INFO[Window(weather).Property(Day2.Title)]</label><label2>$INFO[Window(weather).Property(Day2.HighTemp)]$INFO[Window(weather).Property(Day2.LowTemp), / ]</label2><visible>!String.IsEmpty(Window(weather).Property(Day2.Title))</visible></control>
				<control type="button" id="304"><onback>SetProperty(bz_nav,true,home)</onback><!-- 5.33.179 BUG-024 (BUG-013 pattern): Back opens MM same frame as close, no underlay stop --><width>bz_strip_w</width><height>60</height><font>bz_list_music</font><textoffsetx>23</textoffsetx><aligny>center</aligny><textcolor>FFEBEBEB</textcolor><focusedcolor>FF000000</focusedcolor><texturefocus>colors/white.png</texturefocus><texturenofocus/><label>$INFO[Window(weather).Property(Day3.Title)]</label><label2>$INFO[Window(weather).Property(Day3.HighTemp)]$INFO[Window(weather).Property(Day3.LowTemp), / ]</label2><visible>!String.IsEmpty(Window(weather).Property(Day3.Title))</visible></control>
