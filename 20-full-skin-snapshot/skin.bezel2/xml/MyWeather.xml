				<control type="button" id="307"><onback>SetProperty(bz_nav,true,home)</onback><!-- 5.33.179 BUG-024 (BUG-013 pattern): Back opens MM same frame as close, no underlay stop --><width>bz_strip_w</width><height>60</height><font>bz_list_music</font><textoffsetx>23</textoffsetx><aligny>center</aligny><textcolor>FFEBEBEB</textcolor><focusedcolor>FF000000</focusedcolor><texturefocus>colors/white.png</texturefocus><texturenofocus/><label>$INFO[Window(weather).Property(Day6.Title)]</label><label2>$INFO[Window(weather).Property(Day6.HighTemp)]$INFO[Window(weather).Property(Day6.LowTemp), / ]</label2><visible>!String.IsEmpty(Window(weather).Property(Day6.Title))</visible></control>
				<control type="button" id="310"><onback>SetProperty(bz_nav,true,home)</onback><!-- 5.33.179 BUG-024 (BUG-013 pattern): Back opens MM same frame as close, no underlay stop --><width>bz_strip_w</width><height>60</height><font>bz_list_music</font><textoffsetx>23</textoffsetx><aligny>center</aligny><align>left</align><textcolor>FFEBEBEB</textcolor><focusedcolor>FF000000</focusedcolor><label>NEXT LOCATION</label><texturefocus>colors/white.png</texturefocus><texturenofocus/><onclick>Weather.LocationNext</onclick></control>
				<control type="button" id="311"><onback>SetProperty(bz_nav,true,home)</onback><!-- 5.33.179 BUG-024 (BUG-013 pattern): Back opens MM same frame as close, no underlay stop --><width>bz_strip_w</width><height>60</height><font>bz_list_music</font><textoffsetx>23</textoffsetx><aligny>center</aligny><align>left</align><textcolor>FFEBEBEB</textcolor><focusedcolor>FF000000</focusedcolor><label>$LOCALIZE[5]</label><texturefocus>colors/white.png</texturefocus><texturenofocus/><onclick>ActivateWindow(servicesettings,weather)</onclick></control>
			</control>
			<control type="image"><left>120</left><top>120</top><width>540</width><height>900</height><texture colordiffuse="66000000">colors/white.png</texture></control><control type="label"><left>150</left><top>140</top><width>390</width><height>120</height><font>bz_b60</font><align>left</align><textcolor>FFFFFFFF</textcolor><label>$INFO[Weather.Temperature]</label></control>
			<control type="label"><left>150</left><top>250</top><width>390</width><height>40</height><font>bz_r22</font><align>left</align><textcolor>B3FFFFFF</textcolor><label>[UPPERCASE]$INFO[Weather.Conditions][/UPPERCASE]</label></control>
			<control type="label"><left>150</left><top>300</top><width>390</width><height>40</height><font>bz_r26</font><textcolor>FFFFFFFF</textcolor><label>[UPPERCASE]$VAR[BezelWxHead][/UPPERCASE]</label></control><control type="textbox"><left>150</left><top>350</top><width>390</width><height>590</height><font>bz_bio</font><textcolor>FFFFFFFF</textcolor><label>[UPPERCASE]$VAR[BezelWxBody][/UPPERCASE]</label><autoscroll time="3000" delay="6000" repeat="6000">true</autoscroll></control><control type="label"><left>150</left><top>960</top><width>390</width><height>40</height><font>bz_small</font><align>left</align><textcolor>99FFFFFF</textcolor><label>[UPPERCASE]$INFO[Window(weather).Property(Updated)]$INFO[Window(weather).Property(WeatherProvider), · ][/UPPERCASE]</label></control>
		</control>
		
	</control></controls>
</window>
