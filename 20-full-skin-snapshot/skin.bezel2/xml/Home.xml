<?xml version="1.0" encoding="UTF-8"?>
<!-- BEZEL 2.0: there is no Home screen. Home is a black redirect into the music library's Recently played albums
     (BEZEL MUSIC LIST); Back from the top level of a section returns here and is sent straight back. Kodi still runs its
     library stats job for this window, so the footer counts (Movies.Count etc.) keep working. -->
<window>
	<defaultcontrol always="true">9999</defaultcontrol>
	<backgroundcolor>FF000000</backgroundcolor>
	<onload condition="!String.IsEqual(Skin.String(bz_defseed),5.0.20)">RunScript(special://skin/scripts/bz_tune.py,seed)</onload><onload condition="String.IsEqual(Skin.String(bz_defseed),5.0.20) + !String.IsEqual(Skin.String(bz_fastseed),5.33.471)">RunScript(special://skin/scripts/bz_tune.py,fastseed)</onload><!-- 5.33.471 FASTPACK: faster timing picks, once --><!-- t4691: Rob default picks seed (once per defaults version) -->
	<onload condition="!String.IsEqual(Window(Home).Property(bz_flip_running),true)">RunScript(special://skin/scripts/bz_flip.py)</onload>
	<onload condition="!String.IsEqual(Window(Home).Property(bz_precache_running),true)">RunScript(special://skin/scripts/bz_precache.py)</onload><!-- BEZEL 3.0: artwork pre-cache -->
	<onload>RunScript(special://skin/scripts/bz_cmd.py,start)</onload>
	<controls>
		<include>BezelBlack</include>
		<control type="button" id="9999">
			<left>-100</left><top>-100</top><width>10</width><height>10</height><label></label>
			<texturefocus></texturefocus><texturenofocus></texturenofocus>
			<onclick>RunScript(special://skin/scripts/bz_cmd.py,start)</onclick>
		</control>
			<include>BezelFSUnderlay</include><!-- 5.33.472 FSANY -->
	</controls>
</window>
