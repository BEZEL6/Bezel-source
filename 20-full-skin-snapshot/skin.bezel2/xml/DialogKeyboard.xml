<?xml version="1.0" encoding="UTF-8"?>
<!-- BEZEL 4.0.0 item 15: keyboard in the wide Main menu block (mockups/dialogs/keyboard.png). IDs/navigation from the original kept. -->
<window>
	<defaultcontrol always="true">300</defaultcontrol>
	
	<!-- 5.33.229: Add Source (mediasource) uses BzStripKeyboard; focus lands on the A–Z bar -->
	<!-- 5.33.239: strip keyboard everywhere except Music Refresh and File Manager (Rob pt1854u) -->
	<onload condition="!Window.IsVisible(musicinformation) + !Window.IsVisible(filemanager)">SetFocus(9601)</onload>
	<onunload>ClearProperty(bz_kbcaps,home)</onunload>
	<include condition="Window.IsVisible(filemanager)">Animation_DialogPopupOpenClose</include>
	<depth>DepthDialog+</depth>
	<controls>
		<!-- 5.0.2 Refresh-in-strip: when opened over Music info (Refresh flow) use the strip format -->
		<include condition="Window.IsVisible(musicinformation)">BzRefreshKeyboard</include>
		<include condition="!Window.IsVisible(musicinformation) + !Window.IsVisible(filemanager)">BzStripKeyboard</include>
		<include condition="!Window.IsVisible(musicinformation) + Window.IsVisible(filemanager)">BzStdKeyboard</include>
	</controls>
</window>
