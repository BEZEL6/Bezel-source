<?xml version="1.0" encoding="UTF-8"?>
<window>
	<onload condition="String.IsEmpty(Window(Home).Property(bz_backdrop))">RunScript(special://skin/scripts/bz_cmd.py,backdrop)</onload><!-- 5.33.142: pick once; keep across Music↔Videos / MM section swaps -->
	<!-- 5.33.142: no onunload clear of bz_backdrop (was flash/repick on section change) -->
	<defaultcontrol always="true">60</defaultcontrol>
	<onload condition="!Control.HasFocus(6996) + !String.IsEqual(Window(home).Property(bz_mmpick),true) + !String.IsEmpty(Window(home).Property(bz_mmwarm)) + !String.IsEmpty(Window(home).Property(bz_mmlive))">SetFocus(6996,$INFO[Window(home).Property(bz_mmlive)],absolute)</onload><onload condition="!Control.HasFocus(6996) + !String.IsEqual(Window(home).Property(bz_mmpick),true) + !String.IsEmpty(Window(home).Property(bz_mmwarm)) + String.IsEmpty(Window(home).Property(bz_mmlive))">SetFocus(6996,$INFO[Window(home).Property(bz_mmpos)],absolute)</onload><!-- MMWARM2 t3407 -->
	<onload condition="$EXP[bz_gridfirst] + Integer.IsGreater(Container(6600).NumItems,0) + !$EXP[bz_navmenu] + String.IsEmpty(Window(home).Property(bz_mmwarm))">SetFocus(6600)</onload><!-- 4.0.1 O22: back from fullscreen music the window opened on the list (60) for ~0.5 s before bz_flip moved focus to the grid, so the list bar flashed in and faded out; the grid now takes the focus on load -->
	<backgroundcolor>background</backgroundcolor>
	<views>60</views>
	<menucontrol>9000</menucontrol>
	<onunload>ClearProperty(bz_from_music,home)</onunload>
	<onload>ClearProperty(bz_tovideo,home)</onload>
	<onunload>ClearProperty(bz_minibig,home)</onunload>
	<!-- 2.0a3.1: no stale flip state from an earlier visit, so the first tap always flips -->
	<onload>ClearProperty(bz_vback,home)</onload>
	<onload>ClearProperty(bz_vbackanim,home)</onload>
	<onload>ClearProperty(bz_vback_fade,home)</onload>
	<onload>ClearProperty(bz_vback_close,home)</onload>
	<onload>ClearProperty(bz_minibig,home)</onload>
	<onload condition="!String.IsEqual(Window(Home).Property(bz_flip_running),true)">RunScript(special://skin/scripts/bz_flip.py)</onload>
	<onload>ClearProperty(bz_tv_list,home)</onload>
	<onload>ClearProperty(bz_tv_up,home)</onload>
	<onload condition="Skin.HasSetting(bz_grid_video)">SetProperty(bz_gpend,1,home)</onload><onload>AlarmClock(bzgpend,ClearProperty(bz_gpend,home),00:02,silent)</onload><!-- 4.6.2 nav3: content held hidden until bz_flip has put list 60 + grid on the same item (Kodi restores the old selection first) -->
	<controls>
		<!-- 2.0a3.5: Estuary layers removed (DefaultBackground fanart/visualisation/video window, info/content panels, TopBar, BottomBar, MediaFlags, CommonScrollbars): BEZEL covers them and they only drew behind it -->
		<include>BezelBlack</include><!-- 4.7: window-level black under the BELOW dust -->
		<include>BezelAmbientBelow</include><!-- 4.7 Dust 2.0 ambient BELOW (one of two copies; 1114 = ABOVE) -->
		<control type="group"><!-- 4.7: SECTION PARENT GROUP --><include>BezelSecDim</include><!-- 4.0.1 O25: section content held hidden while it loads behind the Main menu (bz_secload, bz_cmd _bz_load_then_close), then one fade in (bz_secfade) -->
			<animation effect="fade" start="100" end="0" time="0" condition="!String.IsEmpty(Window(Home).Property(bz_secload))">Conditional</animation><animation effect="fade" start="100" end="0" time="0" condition="!String.IsEmpty(Window(Home).Property(bz_gpend))">Conditional</animation>
			<animation effect="fade" start="0" end="100" time="400" tween="sine" easing="out" condition="!String.IsEmpty(Window(Home).Property(bz_secfade))" reversible="false">Conditional</animation>
			<include>BezelFanartCycler</include>
			<include>View_60_BezelVideoPosterList</include><include>BezelDtapHint</include>
			<include>BezelGridVideo</include>
		</control>
		<!-- BEZEL: Estuary side menu moved here so it draws ABOVE the Bezel views -->
		<control type="group">
			<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="$EXP[infodialog_active]">Conditional</animation>
			<!-- 2.0a3.4: Estuary mouse-edge overlay removed (it can cover the BEZEL list hit areas) -->
			<control type="group">
				<include>MediaMenuCommon</include>
				<animation effect="fade" start="0" end="0" time="0" condition="true">Conditional</animation><!-- BEZEL 3.0: the Estuary options blade is never shown; M / Menu lands here and is routed to the BEZEL slide menu -->
				<control type="grouplist" id="9000">
					<onfocus condition="!System.HasModalDialog + !Window.IsVisible(mediasource) + !Window.IsVisible(filebrowser) + !Window.IsVisible(contentsettings) + !Window.IsVisible(smartplaylistrule)">SetFocus(60)</onfocus><onfocus condition="$EXP[bz_navok] + !System.HasModalDialog + !Window.IsVisible(mediasource) + !Window.IsVisible(filebrowser) + !Window.IsVisible(contentsettings) + !Window.IsVisible(smartplaylistrule)">SetProperty(bz_navcard2,true,home)</onfocus><onfocus condition="$EXP[bz_navok] + !System.HasModalDialog + !Window.IsVisible(mediasource) + !Window.IsVisible(filebrowser) + !Window.IsVisible(contentsettings) + !Window.IsVisible(smartplaylistrule)">SetProperty(bz_nav,true,home)</onfocus>
					<top>50</top>
					<include>MediaMenuListCommon</include>
					<control type="button" id="10">
						<description>Watched Toggle</description>
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[20367]</label>
						<label2>[B]$INFO[Container.NumItems][/B]</label2>
						<visible>Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.content(seasons) | Container.Content(episodes) | Container.Content(MusicVideos)</visible>
					</control>
					<control type="label" id="203">
						<include>MediaMenuLabelCommon</include>
						<label>$LOCALIZE[31020]</label>
					</control>
					<control type="radiobutton" id="16">
						<description>PartyMode</description>
						<label>$LOCALIZE[589]</label>
						<include>MediaMenuItemsCommon</include>
						<visible>Container.Content(MusicVideos)</visible>
					</control>
					<control type="radiobutton" id="11">
						<description>Unlock Shares</description>
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[20336]</label>
						<onclick>mastermode</onclick>
						<selected>system.ismaster</selected>
						<visible>system.haslocks</visible>
					</control>
					<control type="togglebutton" id="619">
						<description>Update library</description>
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[653]</label>
						<onclick>UpdateLibrary(video)</onclick>
						<visible>!Container.Content(addons)+ String.IsEmpty(Container.PluginName)</visible>
						<altlabel>$LOCALIZE[13353]</altlabel>
						<usealttexture>library.isscanningvideo</usealttexture>
					</control>
					<control type="button" id="612">
						<description>Go to playlist</description>
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[31056]</label>
						<onclick>ActivateWindow(videoplaylist)</onclick>
						<visible>Integer.IsGreater(Playlist.Length(video),0)</visible>
					</control>
					<control type="button" id="621">
						<description>Get more</description>
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[21452]</label>
						<onclick>ActivateWindow(addonbrowser,addons://more/video/,return)</onclick>
						<visible>Container.Content(addons)</visible>
					</control>
					<control type="button" id="622">
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[31117]</label>
						<onclick condition="System.AddonIsEnabled(plugin.library.node.editor)">ActivateWindow(programs,plugin://plugin.library.node.editor/?ltype=video,return)</onclick>
						<onclick condition="System.HasAddon(plugin.library.node.editor) + !System.AddonIsEnabled(plugin.library.node.editor)">EnableAddon(plugin.library.node.editor)</onclick>
						<onclick condition="!System.HasAddon(plugin.library.node.editor)">InstallAddon(plugin.library.node.editor)</onclick>
						<visible>Container.Content() + String.IsEmpty(Container.PluginName)</visible>
					</control>
					<control type="button" id="623">
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[31009]</label>
						<onclick>InstallAddon(resource.images.studios.white)</onclick>
						<visible>Container.Content(studios) + !System.AddonIsEnabled(resource.images.studios.white)</visible>
					</control>
					<control type="button" id="624">
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[10140]</label>
						<onclick>Addon.OpenSettings($INFO[Container.PluginName])</onclick>
						<visible>!String.IsEmpty(Container.PluginName)</visible>
					</control>
					<include>MediaMenuNowPlaying</include>
				</control>
			</control>
		</control>
		<!-- BEZEL: clickable logo, above the views and the side menu -->
		<include>BezelMiniPlayer</include>
		<control type="group"><include>BezelSecDim</include><include>BezelViewPill</include></control><!-- 4.2 -->
		<control type="group"><include>BezelSecDim</include><include>BezelRootArtHide</include></control>
		<include>BezelLogoButton</include>
	</controls>
</window>
