	<include name="BezelInfoFanOp"><!-- t4165: Info fanart follows LOOK Fanart opacity (bz_at_fanop), same anims as section fanart --><animation effect="fade" start="100" end="0" time="0" condition="String.IsEqual(Skin.String(bz_at_fanop),1)">Conditional</animation><animation effect="fade" start="100" end="10" time="0" condition="String.IsEqual(Skin.String(bz_at_fanop),2)">Conditional</animation><animation effect="fade" start="100" end="20" time="0" condition="String.IsEqual(Skin.String(bz_at_fanop),3)">Conditional</animation><animation effect="fade" start="100" end="30" time="0" condition="String.IsEqual(Skin.String(bz_at_fanop),4)">Conditional</animation><animation effect="fade" start="100" end="40" time="0" condition="String.IsEqual(Skin.String(bz_at_fanop),5)">Conditional</animation><animation effect="fade" start="100" end="50" time="0" condition="[String.IsEmpty(Skin.String(bz_at_fanop)) | String.IsEqual(Skin.String(bz_at_fanop),6)]">Conditional</animation><animation effect="fade" start="100" end="60" time="0" condition="String.IsEqual(Skin.String(bz_at_fanop),7)">Conditional</animation><animation effect="fade" start="100" end="70" time="0" condition="String.IsEqual(Skin.String(bz_at_fanop),8)">Conditional</animation><animation effect="fade" start="100" end="80" time="0" condition="String.IsEqual(Skin.String(bz_at_fanop),9)">Conditional</animation><animation effect="fade" start="100" end="90" time="0" condition="String.IsEqual(Skin.String(bz_at_fanop),10)">Conditional</animation></include>
