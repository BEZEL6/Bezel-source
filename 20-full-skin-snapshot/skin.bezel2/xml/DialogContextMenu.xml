<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- 3.5.7: long-press / context menu on a poster or grid item in the video library opens the in-place extended info (dialog 1111) -->
	<!-- t4005/oct27d: old context killed in libraries/home: any path (keymap, RPC action, longpress) closes it same frame and opens Options+Info -->
	<onload condition="[Window.IsVisible(videos) | Window.IsVisible(music) | Window.IsVisible(home)] ">NotifyAll(bz,bz_ctx)</onload>
	<visible>!Window.IsVisible(videos) + !Window.IsVisible(music) + !Window.IsVisible(home)</visible>
	<defaultcontrol>996</defaultcontrol>
	<!-- BETA 2.7 item 1: BEZEL standard view (was the Estuary popup) -->
	<animation type="WindowOpen"><effect type="fade" start="0" end="100" time="200" tween="cubic" easing="out"/></animation>
	<animation type="WindowClose"><effect type="fade" start="100" end="0" time="150" tween="cubic" easing="in"/></animation>
	<coordinates><left>0</left><top>0</top></coordinates>
	<controls>
		<control type="group"><visible>!Window.IsVisible(filebrowser) + !Window.IsVisible(filemanager) + !$EXP[bz_ctxwarm]</visible><include content="BezelStdFrame">
			<param name="title" value="$INFO[ListItem.Label]"/>
			<param name="sub" value="$LOCALIZE[33063]"/><param name="tpl" value="true"/>
			<param name="head" value="$INFO[ListItem.Label]"/>
			<param name="body" value="LONG-PRESS OR MENU OPENS THESE OPTIONS. BACK CLOSES."/>
		</include></control>
		<!-- 5.33.99 t625: FileBrowser opener → Estuary popup look (dim + dialog_tint panel, centred). 5.33.145 BUG-002: FileManager same path (focus + Back). -->
		<control type="group"><visible>Window.IsVisible(filebrowser) | Window.IsVisible(filemanager)</visible>
			<control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture colordiffuse="B0FFFFFF">colors/white.png</texture><colordiffuse>B0000000</colordiffuse></control>
			<control type="button"><left>0</left><top>0</top><width>1920</width><height>1080</height><texturefocus/><texturenofocus/><onfocus>SetFocus(996)</onfocus><onclick>Action(close)</onclick><!-- 5.33.151 BUG-002: bounce focus to list 996 --></control>
			<control type="image"><left>735</left><top>150</top><width>450</width><height>780</height><texture colordiffuse="dialog_tint">colors/white.png</texture></control>
		</control>
		<!-- 5.33.242 Rob t1862u: source context menu (Media Sources / SOURCES 1132 / Pictures sources root) in the Warm strip: strip chrome at 570,120, rows in the strip, held art behind. Kodi still supplies the rows (Edit source / Remove source …). -->
		<control type="group"><visible>$EXP[bz_ctxwarm]</visible><left>570</left><top>120</top>
			<include content="BezelMMStripChrome"><param name="w" value="450"/><param name="w2" value="530"/></include>
			<control type="label"><left>124</left><top>34</top><width>400</width><height>44</height><aligny>center</aligny><font>bz_mm34</font><textcolor>FFFFFFFF</textcolor><scroll>true</scroll><label>[UPPERCASE]$INFO[ListItem.Label][/UPPERCASE]</label></control>
			<control type="label"><left>126</left><top>78</top><width>400</width><height>24</height><aligny>center</aligny><font>bz_b12</font><textcolor>AAFFFFFF</textcolor><label>SOURCE · OPTIONS</label></control>
			<control type="image"><left>110</left><top>842</top><width>410</width><height>1</height><texture colordiffuse="40FFFFFF">bezel/white.png</texture></control>
			<control type="label"><left>124</left><top>852</top><width>390</width><height>30</height><aligny>center</aligny><font>bz_b12</font><textcolor>AAFFFFFF</textcolor><label>SELECT  runs       ‹ BACK  closes</label></control>
		</control>
		<control type="image" id="999"><left>0</left><top>0</top><width>1920</width><height>4320</height><texture/></control><!-- full-screen size so Kodi positioning (focus-centred, clamped to the screen) lands at 0,0 -->
		<control type="grouplist" id="996">
			<animation effect="slide" end="615,30" time="0" condition="Window.IsVisible(filebrowser) | Window.IsVisible(filemanager)">conditional</animation><animation effect="slide" end="450,112" time="0" condition="$EXP[bz_ctxwarm]">conditional</animation><!-- 5.33.242 Warm strip rows -->
			<left>120</left><top>120</top><width>450</width><height>900</height>
			<itemgap>0</itemgap><orientation>vertical</orientation>
		</control>
		<control type="button" id="1000"><!-- 5.33.94 t592: MM-bar focus (was white/black Estuary-style) -->
			<description>button template</description>
			<width>450</width><height>58</height><font>bz_mm28</font><textoffsetx>44</textoffsetx><aligny>center</aligny><align>$VAR[BzCtxAlign]</align>
			<textcolor>$VAR[BzCtxTxt]</textcolor><focusedcolor>$VAR[BzCtxFocTxt]</focusedcolor>
			<texturefocus border="0" colordiffuse="$VAR[BzCtxBarCol]">lists/focus.png</texturefocus><!-- 5.33.151 BUG-002: literal path, texturefocus does not resolve $VAR --><texturenofocus/>
		</control>
	</controls>
</window>
