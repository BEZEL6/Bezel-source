						<control type="image"><left>36</left><top>15</top><width>28</width><height>28</height><aspectratio>keep</aspectratio><texture colordiffuse="$VAR[BzMMFocTxt]">$INFO[ListItem.Property(icon)]</texture><visible>Control.HasFocus(9000)</visible></control>
						<control type="label"><left>80</left><top>0</top><width>276</width><height>58</height><aligny>center</aligny><font>bz_mm28</font><textcolor>$VAR[BzMMFocTxt]</textcolor><label>$INFO[ListItem.Label]</label><visible>Control.HasFocus(9000)</visible></control>
						<control type="image"><left>36</left><top>15</top><width>28</width><height>28</height><aspectratio>keep</aspectratio><texture colordiffuse="C8FFFFFF">$INFO[ListItem.Property(icon)]</texture><visible>!Control.HasFocus(9000)</visible></control>
						<control type="label"><left>80</left><top>0</top><width>296</width><height>58</height><aligny>center</aligny><font>bz_mm28</font><textcolor>C8FFFFFF</textcolor><label>$INFO[ListItem.Label]</label><visible>!Control.HasFocus(9000)</visible></control>
					</focusedlayout>
					<content>
					<item><label>$LOCALIZE[10003]</label><property name="icon">icons/settings/filemanager.png</property><property name="subs">Sources[CR]Copy / move / delete[CR]Rename[CR]Make folder</property><property name="desc">Browse sources and copy, move or delete files.</property><onclick>ActivateWindow(filemanager)</onclick></item>
					<item><label>$LOCALIZE[24001]</label><property name="icon">icons/settings/addons.png</property><property name="subs">My add-ons[CR]Install from repository[CR]Install from zip file[CR]Available updates[CR]Search</property><property name="desc">Install, update and configure add-ons.</property><onclick>ActivateWindow(addonbrowser)</onclick></item>
					<item><label>$LOCALIZE[138]</label><property name="icon">icons/settings/sysinfo.png</property><property name="subs">Summary[CR]Storage[CR]Network[CR]Video[CR]Hardware</property><property name="desc">Hardware, storage, network and version details.</property><onclick>ActivateWindow(systeminfo)</onclick></item>
					<item><label>$LOCALIZE[31067]</label><property name="icon">icons/settings/eventlog.png</property><property name="subs">All events[CR]Filter by level</property><property name="desc">Recent events and notifications.</property><onclick>ActivateWindow(eventlog)</onclick></item>
					<item><label>$LOCALIZE[14200]</label><property name="icon">icons/settings/player.png</property><property name="subs">Videos[CR]Music[CR]Discs[CR]Pictures[CR]Language</property><property name="desc">Video, music, disc and picture playback.</property><onclick>ActivateWindow(PlayerSettings)</onclick></item>
					<item><label>$LOCALIZE[14211]</label><property name="icon">icons/settings/media.png</property><property name="subs">Library[CR]Videos[CR]Music[CR]Pictures[CR]General</property><property name="desc">Library, sources and media handling.</property><onclick>ActivateWindow(MediaSettings)</onclick></item>
					<item><label>$LOCALIZE[14036]</label><property name="icon">icons/settings/network.png</property><property name="subs">General[CR]Control[CR]UPnP / DLNA[CR]SMB client[CR]Weather</property><property name="desc">Network services, remote control and sharing.</property><onclick>ActivateWindow(ServiceSettings)</onclick></item>
					<item><label>$LOCALIZE[15016]</label><property name="icon">icons/settings/games.png</property><property name="subs">General[CR]Controllers[CR]Emulators</property><property name="desc">Emulators, controllers and game playback.</property><onclick>ActivateWindow(GameSettings)</onclick><visible>System.GetBool(gamesgeneral.enable)</visible></item>
					<item><label>$LOCALIZE[14206]</label><property name="icon">icons/settings/interface.png</property><property name="subs">Skin[CR]Regional[CR]Screensaver[CR]Master lock</property><property name="desc">Skin, regional, screensaver and menu options.</property><onclick>ActivateWindow(InterfaceSettings)</onclick></item>
					<item><label>$LOCALIZE[13200]</label><property name="icon">icons/settings/profiles.png</property><property name="subs">General[CR]Profiles</property><property name="desc">User profiles and login.</property><onclick>ActivateWindow(Profiles)</onclick></item>
					<item><label>$LOCALIZE[13000]</label><property name="icon">icons/settings/system.png</property><property name="subs">Display[CR]Audio[CR]Input[CR]Internet access[CR]Power saving[CR]Add-ons[CR]Logging</property><property name="desc">Display, audio, input, power and logging.</property><onclick>ActivateWindow(SystemSettings)</onclick></item>
					<item><label>LibreELEC</label><property name="icon">icons/settings/libreelec.png</property><property name="subs">System[CR]Network[CR]Connections[CR]Services[CR]Bluetooth[CR]About</property><property name="desc">LibreELEC system configuration.</property><onclick>RunAddon(service.libreelec.settings)</onclick><visible>System.AddonIsEnabled(service.libreelec.settings)</visible></item>
				</content>
				</control>
			</control>
				</control>
		<!-- 4.6.3: BezelMiniPlayer dropped here; the strip carries the mini player like Main menu -->
		</control><!-- 4.7.4 end SECTION PARENT GROUP -->
