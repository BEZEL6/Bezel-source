<?xml version="1.0" encoding="UTF-8"?>
<!-- 5.33.13 (Rob t154 APPROVED, mockup 13): EventLog = fanart stage (detail) + colour strip (events list 50; Left opens OPTIONS sub-list 9000 replacing the list; Back returns) -->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<views>50</views>
	<onunload>ClearProperty(bz_evopt)</onunload>
	<controls><control type="group"><include>BezelSecDim</include>
		<include content="BezelPVRStage"/>
		<control type="group"><include>BezelSecFadeIn</include>
			<control type="image"><left>120</left><top>120</top><width>450</width><height>900</height><texture colordiffuse="66000000">colors/white.png</texture></control>
			<control type="image"><left>150</left><top>150</top><width>120</width><height>120</height><aspectratio>keep</aspectratio><texture fallback="DefaultAddon.png">$INFO[Container(50).ListItem.Icon]</texture></control>
			<control type="label"><left>150</left><top>290</top><width>390</width><height>40</height><font>bz_r26</font><textcolor>FFFFFFFF</textcolor><scroll>true</scroll><label>[UPPERCASE]$INFO[Container(50).ListItem.Label][/UPPERCASE]</label></control>
			<control type="label"><left>150</left><top>335</top><width>390</width><height>30</height><font>bz_r20</font><textcolor>B3FFFFFF</textcolor><label>[UPPERCASE]$INFO[Container(50).ListItem.Property(Event.Level)]$INFO[Container(50).ListItem.Date, · ][/UPPERCASE]</label></control>
			<control type="textbox"><left>150</left><top>380</top><width>390</width><height>600</height><font>bz_bio</font><textcolor>FFFFFFFF</textcolor><label>$INFO[Container(50).ListItem.Property(Event.Description)]</label><autoscroll time="3000" delay="6000" repeat="6000">true</autoscroll></control>
			<control type="list" id="50"><left>570</left><top>120</top><width>390</width><height>900</height><onleft>SetProperty(bz_evopt,1)</onleft><onleft>SetFocus(9000)</onleft><onright>SetProperty(bz_evopt,1)</onright><onright>SetFocus(9000)</onright><onup>50</onup><ondown>50</ondown><pagecontrol>60</pagecontrol><scrolltime tween="sine">200</scrolltime><viewtype label="535">list</viewtype>
				<visible>String.IsEmpty(Window.Property(bz_evopt))</visible>
				<itemlayout width="390" height="60"><control type="label"><left>23</left><width>350</width><height>60</height><font>bz_list_music</font><aligny>center</aligny><textcolor>FFEBEBEB</textcolor><label>[UPPERCASE]$INFO[ListItem.Label][/UPPERCASE]</label></control></itemlayout>
				<focusedlayout width="390" height="60"><control type="image"><width>390</width><height>60</height><texture colordiffuse="$VAR[BzATHiCol]">$VAR[BzATHiTex]</texture><visible>Control.HasFocus(50)</visible></control>
					<control type="label"><left>23</left><width>350</width><height>60</height><font>bz_list_music</font><aligny>center</aligny><textcolor>$VAR[BzATHiText]</textcolor><scroll>true</scroll><label>[UPPERCASE]$INFO[ListItem.Label][/UPPERCASE]</label></control></focusedlayout>
			</control>
			<control type="scrollbar" id="60"><left>-400</left><top>120</top><width>8</width><height>900</height><orientation>vertical</orientation><onleft>50</onleft><onright>50</onright></control>
			<control type="label"><left>593</left><top>130</top><width>350</width><height>40</height><font>bz_r20</font><textcolor>B3FFFFFF</textcolor><label>‹ OPTIONS</label><visible>!String.IsEmpty(Window.Property(bz_evopt))</visible></control>
			<control type="grouplist" id="9000"><left>570</left><top>180</top><width>390</width><height>840</height><itemgap>0</itemgap><onup>9000</onup><ondown>9000</ondown><onleft>ClearProperty(bz_evopt)</onleft><onleft>SetFocus(50)</onleft><onright>ClearProperty(bz_evopt)</onright><onright>SetFocus(50)</onright>
				<visible>!String.IsEmpty(Window.Property(bz_evopt))</visible>
				<control type="togglebutton" id="4"><width>390</width><height>60</height><font>bz_list_music</font><textoffsetx>23</textoffsetx><aligny>center</aligny><textcolor>FFEBEBEB</textcolor><focusedcolor>FF000000</focusedcolor><texturefocus>colors/white.png</texturefocus><texturenofocus/><label>$LOCALIZE[31032]: $LOCALIZE[584]</label><altlabel>$LOCALIZE[31032]: $LOCALIZE[585]</altlabel><alttexturefocus>colors/white.png</alttexturefocus><alttexturenofocus/><onback>ClearProperty(bz_evopt)</onback><onback>SetFocus(50)</onback></control>
				<control type="button" id="21"><width>390</width><height>60</height><font>bz_list_music</font><textoffsetx>23</textoffsetx><aligny>center</aligny><textcolor>FFEBEBEB</textcolor><focusedcolor>FF000000</focusedcolor><texturefocus>colors/white.png</texturefocus><texturenofocus/><onback>ClearProperty(bz_evopt)</onback><onback>SetFocus(50)</onback></control>
				<control type="radiobutton" id="22"><width>390</width><height>60</height><font>bz_list_music</font><textoffsetx>23</textoffsetx><aligny>center</aligny><textcolor>FFEBEBEB</textcolor><focusedcolor>FF000000</focusedcolor><texturefocus>colors/white.png</texturefocus><texturenofocus/><onback>ClearProperty(bz_evopt)</onback><onback>SetFocus(50)</onback></control>
				<control type="button" id="20"><width>390</width><height>60</height><font>bz_list_music</font><textoffsetx>23</textoffsetx><aligny>center</aligny><textcolor>FFEBEBEB</textcolor><focusedcolor>FF000000</focusedcolor><texturefocus>colors/white.png</texturefocus><texturenofocus/><label>$LOCALIZE[192]</label><onback>ClearProperty(bz_evopt)</onback><onback>SetFocus(50)</onback></control>
				<control type="button" id="501"><width>390</width><height>60</height><font>bz_list_music</font><textoffsetx>23</textoffsetx><aligny>center</aligny><textcolor>FFEBEBEB</textcolor><focusedcolor>FF000000</focusedcolor><texturefocus>colors/white.png</texturefocus><texturenofocus/><label>$LOCALIZE[5]</label><onclick>ActivateWindow(systemsettings,logging)</onclick><onback>ClearProperty(bz_evopt)</onback><onback>SetFocus(50)</onback></control>
			</control>
		</control>
		<include>BezelLogo</include>
		<include>BezelMiniPlayer</include>
	</control><include>BezelLogoButton</include></controls>
</window>
