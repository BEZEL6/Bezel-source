<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- BETA 1.1: recently played songs (startup landing) -->
<smartplaylist type="songs">
    <name>Recently played songs</name>
    <match>all</match>
    <rule field="lastplayed" operator="inthelast"><value>3650</value></rule>
    <limit>100</limit>
    <order direction="descending">lastplayed</order>
</smartplaylist>
