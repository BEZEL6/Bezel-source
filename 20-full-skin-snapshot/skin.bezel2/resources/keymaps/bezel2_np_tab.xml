<!-- BEZEL 2.0 BETA 1.1 (installed into the profile keymaps as zz_bezel2_np_tab.xml by bz_cmd.py keymap): Tab / remote Display (FullScreen)
     open the Now Playing dialog (1112) straight from the music window and close it from the dialog, with plain builtins (no Python start-up delay).
     The dialog's onload checks music is playing in the list view; otherwise it closes at once and opens Kodi's fullscreen music window as before. -->
<keymap>
	<music>
		<keyboard><m>ActivateWindow(1115)</m><tab>ActivateWindow(1121)</tab><escape>Back</escape></keyboard><!-- 5.33.210: Tab in Music -> Music Fanart FS 1121 (falls back to viz via 1121 kill switch). BETA 2.3 item 11: Esc = Back, so at the top level it opens the slide menu (list onback) instead of leaving -->
		<remote><display>ActivateWindow(1121)</display><red>ActivateWindow(1115)</red></remote>
		<keyboard><red>ActivateWindow(1115)</red></keyboard><!-- BEZEL 3.2.0 item 7: CEC RED (Samsung Frame 123/colour pad; arrives as remote red, or as keyboard red via Android PROG_RED on the Shield) opens the music controls -->
	</music>
	<videos>
		<keyboard><escape>Back</escape></keyboard><!-- BETA 2.3 item 11 -->
	</videos>
	<!-- BETA 1.1b: Kodi's busy dialog is up while a song opens (long on the first play after Kodi starts: audio output init), and keys then go to it,
	     not to the music window. Tab / Display there are remembered (bz_tabq) and bz_flip.py opens Now Playing once the busy dialog is gone. -->
	<busydialog>
		<keyboard><tab>SetProperty(bz_tabq,true,home)</tab></keyboard>
		<remote><display>SetProperty(bz_tabq,true,home)</display></remote>
	</busydialog>
	<busydialognocancel>
		<keyboard><tab>SetProperty(bz_tabq,true,home)</tab></keyboard>
		<remote><display>SetProperty(bz_tabq,true,home)</display></remote>
	</busydialognocancel>
	<window1121><!-- 5.33.210 Music Fanart FS: same keys as <visualisation> -->
		<keyboard><m>ActivateWindow(1115)</m><red>ActivateWindow(1115)</red><tab>Dialog.Close(1121)</tab><escape>Back</escape><backspace>SetFocus(6422)</backspace><browser_back>SetFocus(6422)</browser_back><return mod="longpress">PlayPause</return><enter mod="longpress">PlayPause</enter></keyboard>
		<remote><display>Dialog.Close(1121)</display><red>ActivateWindow(1115)</red><back>SetFocus(6422)</back></remote>
		<joystick profile="game.controller.default"><b>SetFocus(6422)</b></joystick><joystick profile="game.controller.shield"><b>SetFocus(6422)</b></joystick>
	</window1121>
	<!-- 5.33.465 OLDNP: <window1112> removed with the old Now Playing dialog -->
	<!-- BETA 2.6 item 5: hold Select = context menu skin-wide. The Shield remote / game pad centre (DPAD_CENTER) arrives in Kodi as the keyboard key "return"
	     (some remotes send "enter"); CEC remotes as <remote><select>. Long-press needs Kodi's default long-press delay. -->
	<window1115><keyboard><m>Dialog.Close(1115)</m><red>Dialog.Close(1115)</red></keyboard><remote><red>Dialog.Close(1115)</red></remote></window1115><!-- BEZEL 3.2.0: M opens / closes the music controls -->
	<!-- 4.3.0 O67: was <global>; now only the BEZEL windows, so dialogs (e.g. Add video source) and edit fields keep their own keys; bare C removed -->
	<home>
		<keyboard><return mod="longpress">NotifyAll(bz,bz_ctx)</return><enter mod="longpress">NotifyAll(bz,bz_ctx)</enter></keyboard>
		<remote><select mod="longpress">NotifyAll(bz,bz_ctx)</select></remote>
		<!-- BETA 2.8: Samsung Frame via HDMI-CEC sends a held button as repeats (longpress may never fire): its MENU/TOOLS key arrives as remote menu / contentsmenu / rootmenu / topmenu = ContextMenu. BETA 2.7 item 7: Shield controller / gamepad A and the Android dpad-centre / select key codes. Joystick keymaps take holdtime (ms), not mod="longpress" -->
		<gamepad><a mod="longpress">NotifyAll(bz,bz_ctx)</a></gamepad>
		<joystick profile="game.controller.default"><a holdtime="500">NotifyAll(bz,bz_ctx)</a></joystick>
		<joystick profile="game.controller.shield"><a holdtime="500">NotifyAll(bz,bz_ctx)</a></joystick>
		<keyboard><key id="61453" mod="longpress">NotifyAll(bz,bz_ctx)</key><key id="61711" mod="longpress">NotifyAll(bz,bz_ctx)</key><key id="61643" mod="longpress">NotifyAll(bz,bz_ctx)</key><menu>NotifyAll(bz,bz_ctx)</menu><menu mod="longpress">NotifyAll(bz,bz_ctx)</menu></keyboard>
		<remote><menu>NotifyAll(bz,bz_ctx)</menu><title>NotifyAll(bz,bz_ctx)</title><contentsmenu>NotifyAll(bz,bz_ctx)</contentsmenu><rootmenu>NotifyAll(bz,bz_ctx)</rootmenu><topmenu>NotifyAll(bz,bz_ctx)</topmenu><enter mod="longpress">NotifyAll(bz,bz_ctx)</enter></remote>
		<!-- 5.33.321 Rob t2408: Home is a bounce pad; ignore quick/CEC-repeat Back here so Kodi default Back -> ShutdownMenu (Power 1118) never fires -->
		<keyboard><escape>noop</escape><backspace>noop</backspace><browser_back>noop</browser_back></keyboard>
		<remote><back>noop</back></remote>
		<gamepad><b>noop</b><back>noop</back></gamepad>
		<joystick profile="game.controller.default"><b>noop</b></joystick>
		<joystick profile="game.controller.shield"><b>noop</b></joystick>
	</home>
