<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- In-viz tuner (stubs). Skin overrides via Window(Home) properties, see src/Tuner.cpp -->
<settings version="1">
  <section id="visualization.bezel">
    <category id="main" label="Bezel Viz">
      <group id="1">
        <setting id="active_style" type="string" label="Active style pack"><level>0</level><default>topbar_smear</default><control type="edit" format="string"/></setting>
        <setting id="pack_root" type="string" label="Pack root override (blank = special://skin/viz.addons/)"><level>0</level><default></default><constraints><allowempty>true</allowempty></constraints><control type="edit" format="string"/></setting>
        <setting id="particle_cap" type="integer" label="Particle cap"><level>0</level><default>400</default><constraints><minimum>0</minimum><step>50</step><maximum>2000</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="intensity" type="integer" label="Audio intensity %"><level>0</level><default>100</default><constraints><minimum>0</minimum><step>10</step><maximum>300</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="idle_mode" type="integer" label="Silence behaviour"><level>0</level><default>1</default><constraints><options><option label="Freeze">0</option><option label="Slow drift">1</option><option label="Fade out">2</option></options></constraints><control type="spinner" format="string"/></setting>
        <setting id="strobes" type="boolean" label="Light strobes"><level>0</level><default>false</default><control type="toggle"/></setting>
        <setting id="debug_overlay" type="boolean" label="Debug overlay (fps / bins / style)"><level>0</level><default>false</default><control type="toggle"/></setting>
      </group>
    </category>
    <category id="topbar" label="Smear">
      <group id="1">
        <setting id="smear_style" type="integer" label="Smear style"><level>0</level><default>1</default><constraints><options><option label="Original">0</option><option label="A Cascade">1</option><option label="B Side whip">2</option><option label="C Neon rain">3</option><option label="D Fog bloom">4</option><option label="E Mirror">5</option><option label="F Stagger">6</option></options></constraints><control type="spinner" format="string"/></setting>
        <setting id="smear_place" type="integer" label="Placement"><level>0</level><default>0</default><constraints><options><option label="Top">0</option><option label="Bottom">1</option><option label="Mirror">2</option></options></constraints><control type="spinner" format="string"/></setting>
        <setting id="topbar_columns" type="integer" label="Columns (0 = pack)"><level>0</level><default>0</default><constraints><minimum>0</minimum><step>4</step><maximum>64</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="topbar_colwidth" type="integer" label="Column width % (0 = pack)"><level>0</level><default>0</default><constraints><minimum>0</minimum><step>10</step><maximum>120</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="topbar_align" type="integer" label="Position"><level>0</level><default>0</default><constraints><options><option label="Full width">0</option><option label="Left">1</option><option label="Center">2</option><option label="Right">3</option></options></constraints><control type="spinner" format="string"/></setting>
        <setting id="topbar_height" type="integer" label="Height %"><level>0</level><default>100</default><constraints><minimum>40</minimum><step>10</step><maximum>200</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="topbar_colors" type="integer" label="Colors"><level>0</level><default>0</default><constraints><options><option label="Rainbow (pack)">0</option><option label="Warm">1</option><option label="Cool">2</option><option label="Neon pink">3</option><option label="Mono white">4</option><option label="Ember">5</option></options></constraints><control type="spinner" format="string"/></setting>
        <setting id="topbar_opacity" type="integer" label="Opacity %"><level>0</level><default>100</default><constraints><minimum>10</minimum><step>10</step><maximum>100</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="topbar_sens" type="integer" label="Sensitivity %"><level>0</level><default>100</default><constraints><minimum>25</minimum><step>25</step><maximum>300</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="topbar_smear" type="integer" label="Smear length %"><level>0</level><default>100</default><constraints><minimum>20</minimum><step>10</step><maximum>200</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="topbar_blur" type="integer" label="Blur %"><level>0</level><default>100</default><constraints><minimum>20</minimum><step>10</step><maximum>250</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="topbar_glow" type="integer" label="Glow %"><level>0</level><default>100</default><constraints><minimum>0</minimum><step>10</step><maximum>250</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="topbar_thick" type="integer" label="Bar thickness %"><level>0</level><default>100</default><constraints><minimum>30</minimum><step>10</step><maximum>300</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="topbar_release" type="integer" label="Fade / release %"><level>0</level><default>100</default><constraints><minimum>20</minimum><step>20</step><maximum>400</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="topbar_offx" type="integer" label="Position X offset % (+ = right)"><level>0</level><default>0</default><constraints><minimum>-50</minimum><step>1</step><maximum>50</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="topbar_offy" type="integer" label="Position Y offset % (+ = down)"><level>0</level><default>0</default><constraints><minimum>-20</minimum><step>1</step><maximum>80</maximum></constraints><control type="slider" format="integer"/></setting>
      </group>
    </category>
    <category id="hair" label="Hair">
      <group id="1">
        <setting id="hair_tex_opacity" type="integer" label="Baked hair texture opacity % (-5 = pack)"><level>0</level><default>-5</default><constraints><minimum>-5</minimum><step>5</step><maximum>100</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="hair_color" type="integer" label="Hair color"><level>0</level><default>0</default><constraints><options><option label="Pack">0</option><option label="Red">1</option><option label="Crimson">2</option><option label="Ember orange">3</option><option label="Hot pink">4</option><option label="Violet">5</option><option label="White">6</option></options></constraints><control type="spinner" format="string"/></setting>
        <setting id="hair_opacity" type="integer" label="Live hair opacity %"><level>0</level><default>100</default><constraints><minimum>10</minimum><step>10</step><maximum>200</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="hair_artic_hang" type="integer" label="Hinge droop % (-5 = pack)"><level>0</level><default>-5</default><constraints><minimum>-5</minimum><step>5</step><maximum>100</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="hair_artic_joint" type="integer" label="Hinge height % from root (-5 = pack)"><level>0</level><default>-5</default><constraints><minimum>-5</minimum><step>5</step><maximum>60</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="hair_length" type="integer" label="Hair length %"><level>0</level><default>100</default><constraints><minimum>30</minimum><step>10</step><maximum>250</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="hair_hinges" type="integer" label="Hinges per radial"><level>0</level><default>1</default><constraints><options><option label="Off">0</option><option label="1">1</option><option label="2">2</option><option label="3">3</option></options></constraints><control type="spinner" format="string"/></setting>
        <setting id="hair_hinge2_pos" type="integer" label="Hinge 2 height % from root"><level>0</level><default>55</default><constraints><minimum>10</minimum><step>5</step><maximum>95</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="hair_hinge2_amt" type="integer" label="Hinge 2 droop %"><level>0</level><default>35</default><constraints><minimum>0</minimum><step>5</step><maximum>100</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="hair_hinge3_pos" type="integer" label="Hinge 3 height % from root"><level>0</level><default>80</default><constraints><minimum>10</minimum><step>5</step><maximum>95</maximum></constraints><control type="slider" format="integer"/></setting>
        <setting id="hair_hinge3_amt" type="integer" label="Hinge 3 droop %"><level>0</level><default>35</default><constraints><minimum>0</minimum><step>5</step><maximum>100</maximum></constraints><control type="slider" format="integer"/></setting>
      </group>
    </category>
  </section>
</settings>
