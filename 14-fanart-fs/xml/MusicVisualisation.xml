<?xml version="1.0" encoding="utf-8"?>
<!-- 3.5.2: Kodi's fullscreen music window (12006: Tab / FullScreen / "switch to visualisation on playback").
     From the music window (or the Now Playing dialog over it) it still toggles the in-place Now Playing panel (bz_np) and goes straight back to the
     music screen with plain builtins (vistoggle, debounced).
     BETA 2 items 2 + 3: from any NON-music window (Home, Movies, TV, Pictures, Settings...) it is a real full-screen Now Playing window of its own:
     the same Now Playing panel (BezelNPInPlace, with its black / fanart / colour block background), the swaying album (BezelMusicPlayingArt),
     the same player controls (M / tap) and the logo. Back, Tab / Display, a logo tap or the music stopping close it with Kodi's PreviousWindow,
     so it returns to the window / section it was opened from. -->
<window>
	<backgroundcolor>00000000</backgroundcolor>
	<defaultcontrol always="true">6390</defaultcontrol>
	<menucontrol>6385</menucontrol>
	<onload condition="Window.Previous(music) | Window.Previous(musicplaylist) | Window.Previous(1112)">SetProperty(bz_fsbounce,1,home)</onload><onload condition="Window.Previous(music) | Window.Previous(musicplaylist) | Window.Previous(1112)">AlarmClock(bzfsbounce,ClearProperty(bz_fsbounce,home),00:01,silent)</onload><!-- 5.33.52: Music FS bounce, list 60 cover-column fades skipped -->
	<onload condition="Window.Previous(music) | Window.Previous(musicplaylist) | Window.Previous(1112)">RunScript(special://skin/scripts/bz_cmd.py,vistoggle)</onload>
	<onload condition="Window.Previous(music) | Window.Previous(musicplaylist) | Window.Previous(1112)">ReplaceWindow(Music)</onload>
	<onload>RunScript(special://skin/scripts/bz_cmd.py,keymap)</onload><!-- 5.33.137 t976: refresh viz keymap (Select/pad -> 6390) -->
	<onload>SetProperty(bz_pnoff,1,home)</onload><onload condition="String.IsEmpty(Skin.String(bz_dfs_mode))">Skin.SetString(bz_dfs_mode,album)</onload><!-- 5.33.109: land in fanart FS; Play Next by double-tap; pill default album -->
	<onload condition="!Window.Previous(music) + !Window.Previous(musicplaylist) + !Window.Previous(1112)">SetProperty(bz_fsnp,true,home)</onload>
	<onload condition="!Window.Previous(music) + !Window.Previous(musicplaylist) + !Window.Previous(1112)">SetProperty(bz_np,true,home)</onload>
	<onload condition="!Window.Previous(music) + !Window.Previous(musicplaylist) + !Window.Previous(1112)">AlarmClock(bz_fsfoc,SetFocus(6390),00:00,silent)</onload><!-- Fanart FS: re-focus 6390 after bz_np visible (defaultcontrol can miss hidden 6390 at init) -->
	<onload condition="!Window.Previous(music) + !Window.Previous(musicplaylist) + !Window.Previous(1112) + !String.IsEqual(Window(Home).Property(bz_flip_running),true)">RunScript(special://skin/scripts/bz_flip.py)</onload>
	<onload condition="!Window.Previous(music) + !Window.Previous(musicplaylist) + !Window.Previous(1112)">SetProperty(bz_sway_restart,true,home)</onload>
	<onunload condition="String.IsEqual(Window(Home).Property(bz_fsnp),true)">ClearProperty(bz_np,home)</onunload>
	<onunload condition="!$EXP[bz_navmenu]">AlarmClock(bz_vizret,SetFocus(60),00:00,silent)</onunload><!-- 5.33.112 t786: Play Next / viz exit -> section list 60 --><onunload>ClearProperty(bz_fsnp,home)</onunload><onunload>ClearProperty(bz_pnoff,home)</onunload><onunload>ClearProperty(bz_pnfoc,home)</onunload><onunload>ClearProperty(bz_vdtap,home)</onunload><!-- 5.33.108 t732: Back in play-next = plain viz FS -->
	<onunload>SetProperty(bz_gridret,1,home)</onunload><onunload>AlarmClock(bzgridret,ClearProperty(bz_gridret,home),00:01,silent)</onunload><!-- 4.0.1 O22: the section underneath holds its list hidden for 1 s if its grid takes the focus (no list bar flash) -->
	<controls>
		<control type="group">
			<visible>String.IsEqual(Window(Home).Property(bz_fsnp),true)</visible>
			<animation effect="fade" start="0" end="100" time="300" tween="sine" easing="inout">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="300" tween="sine" easing="inout">WindowClose</animation>
			<include>BezelBlack</include>
			<!-- Christmas FS layer now lives in BezelNPInPlace (works from Music FS too) -->
			<include>BezelLogo</include>
			<control type="group"><animation effect="slide" start="0,0" end="-1100,0" time="480" tween="sine" easing="inout" condition="[!String.IsEqual(Window(Home).Property(bz_pnoff),1)] + String.IsEqual(Skin.String(bz_at_fsslide),1)">Conditional</animation><animation effect="slide" start="0,0" end="-1100,0" time="380" tween="sine" easing="inout" condition="[!String.IsEqual(Window(Home).Property(bz_pnoff),1)] + String.IsEqual(Skin.String(bz_at_fsslide),2)">Conditional</animation><animation effect="slide" start="0,0" end="-1100,0" time="280" tween="sine" easing="inout" condition="[!String.IsEqual(Window(Home).Property(bz_pnoff),1)] + [String.IsEmpty(Skin.String(bz_at_fsslide)) | String.IsEqual(Skin.String(bz_at_fsslide),3)]">Conditional</animation><animation effect="slide" start="0,0" end="-1100,0" time="180" tween="sine" easing="inout" condition="[!String.IsEqual(Window(Home).Property(bz_pnoff),1)] + String.IsEqual(Skin.String(bz_at_fsslide),4)">Conditional</animation><!-- 5.33.163 FS slide speed (bz_at_fsslide): Slow 480 legacy / Mid-low 380 / Mid-high 280 default / Fast 180 --><animation effect="slide" start="-1100,0" end="0,0" time="480" delay="600" tween="sine" easing="inout" condition="[!String.IsEqual(Window(Home).Property(bz_pnoff),1)]">WindowClose</animation><!-- 5.33.105 t717: Back = sides fade 600 first, then stage slides home --><!-- 5.33.102 t654 BezelFSLeftStage: viz Play Next = 1120 template: NP stage slides -1100 (was instant alpha 0) --><!-- 5.33.64 Play Next: NP panel drawn invisible, 6390 keeps focus (OK play/pause, Left/Right prev/next) --><include content="BezelNPInPlace"><param name="npfade" value="1000"/><param name="upc1" value="4DFFFFFF"/><param name="upc2" value="4DFFFFFF"/><param name="upc3" value="4DFFFFFF"/></include><!-- Oct 31 2026: fan art pill 6391 (6-mode bz_npmode: VIS→BIO→FANART→LYRICS→UP NEXT→CONTROLS, default VIS) BOUND as fan art pill to Fanart FS / MusicVisualisation via BezelNPInPlace --></control><!-- BETA 2 item 4: Up Next text white 30% -->
			<control type="group"><visible>![[!String.IsEqual(Window(Home).Property(bz_pnoff),1)] + !String.IsEqual(Window(Home).Property(bz_pnoff),1)]</visible><include>BezelMusicPlayingArt</include></control><control type="group"><left>-480</left><visible>[!String.IsEqual(Window(Home).Property(bz_pnoff),1)]</visible><!-- 5.33.85 t563: Play Next album moved with left (not a slide anim) so the sway camera moves with it: perspective centred on the album at 960 (was skewed: camera stayed at 1440). 5.33.64 Play Next: same playing album (sway/effects) moved to centre 660,220 --><include>BezelMusicPlayingArt</include></control>
			<control type="group"><animation effect="fade" start="100" end="0" time="600" tween="sine" easing="inout">WindowClose</animation><include content="BezelFSPlayNext"><param name="sdelay" value="3000"/><param name="sfade" value="2000"/><param name="sides" value="!String.IsEqual(Skin.String(bz_dfs_mode),album)"/></include><!-- Oct 31 2026: sides gated by big album pill bz_dfs_mode (match 1120); vis default [!bz_pnoff]+HasAudio --></control><!-- 5.33.105 t717 sides fade first on Back -->
			<!-- Oct 31 2026: big album pill 6401 — same as Dialogue FS 1120 (sibling of FSPlayNext wrapper); album viz only. Fan art pill 6391 stays. -->
			<include content="BezelBigAlbumPill"><param name="vis" value="[!String.IsEqual(Window(Home).Property(bz_pnoff),1)] + Player.HasAudio"/><param name="main" value="6390"/></include>
			<control type="group"><animation effect="slide" start="0,0" end="-1100,0" time="480" tween="sine" easing="inout" condition="[!String.IsEqual(Window(Home).Property(bz_pnoff),1)] + String.IsEqual(Skin.String(bz_at_fsslide),1)">Conditional</animation><animation effect="slide" start="0,0" end="-1100,0" time="380" tween="sine" easing="inout" condition="[!String.IsEqual(Window(Home).Property(bz_pnoff),1)] + String.IsEqual(Skin.String(bz_at_fsslide),2)">Conditional</animation><animation effect="slide" start="0,0" end="-1100,0" time="280" tween="sine" easing="inout" condition="[!String.IsEqual(Window(Home).Property(bz_pnoff),1)] + [String.IsEmpty(Skin.String(bz_at_fsslide)) | String.IsEqual(Skin.String(bz_at_fsslide),3)]">Conditional</animation><animation effect="slide" start="0,0" end="-1100,0" time="180" tween="sine" easing="inout" condition="[!String.IsEqual(Window(Home).Property(bz_pnoff),1)] + String.IsEqual(Skin.String(bz_at_fsslide),4)">Conditional</animation><!-- 5.33.163 FS slide speed (bz_at_fsslide): Slow 480 legacy / Mid-low 380 / Mid-high 280 default / Fast 180 --><animation effect="slide" start="-1100,0" end="0,0" time="480" delay="600" tween="sine" easing="inout" condition="[!String.IsEqual(Window(Home).Property(bz_pnoff),1)]">WindowClose</animation><!-- 5.33.105 t717: Back = sides fade 600 first, then stage slides home --><!-- 5.33.102 t654 BezelFSLeftStage (viz play-next) controls slide --><include content="BezelNPControls"><param name="vis" value="$EXP[bz_np] + String.IsEqual(Window(Home).Property(bz_npctl),true)"/><param name="dx" value="0"/><param name="box" value="false"/></include></control>
		</control>
		<!-- logo tap / Back trap (the panel's Back / Left go to 6299): back to the window Now Playing was opened from -->
		<control type="button" id="6387"><left>0</left><top>0</top><width>120</width><height>116</height><label></label><texturefocus></texturefocus><texturenofocus></texturenofocus>
			<onclick>ClearProperty(bz_np,home)</onclick><onclick>Action(Back)</onclick></control>
		<control type="button" id="6297"><left>-400</left><top>40</top><width>10</width><height>10</height><label></label><texturefocus></texturefocus><texturenofocus></texturenofocus><onfocus condition="[!String.IsEqual(Window(Home).Property(bz_pnoff),1)]">SetProperty(bz_pnoff,1,home)</onfocus><onfocus condition="![!String.IsEqual(Window(Home).Property(bz_pnoff),1)]">Action(Back)</onfocus><onfocus>SetFocus(6390)</onfocus></control><!-- 5.33.108 t732: viz Back key: play-next on = drop to plain viz FS (no exit anim); else normal Back. Esc = Back = fade sides, slide home, exit -->
		<control type="button" id="6299"><left>-400</left><top>0</top><width>10</width><height>10</height><label></label><texturefocus></texturefocus><texturenofocus></texturenofocus><onfocus>ClearProperty(bz_np,home)</onfocus><onfocus>Action(Back)</onfocus></control>
		<control type="button" id="6385"><left>-400</left><top>40</top><width>10</width><height>10</height><label></label><texturefocus></texturefocus><texturenofocus></texturenofocus>
			<onfocus>SetFocus(6390)</onfocus><onfocus>RunScript(special://skin/scripts/bz_cmd.py,npctl,toggle)</onfocus></control>
		<control type="button" id="60"><left>-400</left><top>80</top><width>10</width><height>10</height><label></label><texturefocus></texturefocus><texturenofocus></texturenofocus><onfocus>SetFocus(6390)</onfocus></control>
		<!-- 4.0.1 O36 (Rob): album tap-to-enlarge/shrink target 6188 removed -->
		<!-- 5.33.117 t815: touch a side album (sides active) = play that song; mouse-only, keys never land here --><control type="button" id="6407"><left>90</left><top>250</top><width>540</width><height>540</height><label></label><texturefocus></texturefocus><texturenofocus></texturenofocus><visible>[!String.IsEqual(Window(Home).Property(bz_pnoff),1)] + !String.IsEqual(Skin.String(bz_dfs_mode),album) + !String.IsEmpty(MusicPlayer.offset(-1).Title)</visible><onfocus>SetFocus(6390)</onfocus><onclick>Playlist.PlayOffset(music,-1)</onclick></control><control type="button" id="6408"><left>1290</left><top>250</top><width>540</width><height>540</height><label></label><texturefocus></texturefocus><texturenofocus></texturenofocus><visible>[!String.IsEqual(Window(Home).Property(bz_pnoff),1)] + !String.IsEqual(Skin.String(bz_dfs_mode),album) + !String.IsEmpty(MusicPlayer.offset(1).Title)</visible><onfocus>SetFocus(6390)</onfocus><onclick>Playlist.PlayOffset(music,1)</onclick></control>
		<!-- 5.33.128 t926 touch (mouse-only, keys never land): tap fanart = Up Next list; tap big album = Play Next -->
		<control type="button" id="6410"><left>960</left><top>0</top><width>960</width><height>1080</height><label></label><texturefocus></texturefocus><texturenofocus></texturenofocus><visible>String.IsEqual(Window(Home).Property(bz_pnoff),1) + !String.IsEqual(Window(Home).Property(bz_npctl),true)</visible><onfocus>SetFocus(6390)</onfocus><onclick>Skin.SetString(bz_npmode,upnext)</onclick></control>
		<control type="button" id="6409"><left>1100</left><top>220</top><width>680</width><height>680</height><label></label><texturefocus></texturefocus><texturenofocus></texturenofocus><visible>String.IsEqual(Window(Home).Property(bz_pnoff),1) + !String.IsEqual(Window(Home).Property(bz_npctl),true)</visible><onfocus>SetFocus(6390)</onfocus><onclick>ClearProperty(bz_pnoff,home)</onclick></control>
	</controls>
</window>
